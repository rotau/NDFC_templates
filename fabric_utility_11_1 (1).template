AAA_CONF_DESCRIPTION = "AAA configurations"
BROWNFIELD_AAA_CONF_DESCRIPTION = "DCNM AAA extra configurations"
TEMPLATE_DME_INTF_STATS_LOAD_INTERVAL = "dme_intf_stats_interval"

def getFabErrEntity(fnName, entityName=None):
    if entityName:
        return fnName + ":" + entityName
    else:
        return fnName

def isVirtualVPCSwitch(FABRIC_NAME, sn):
    funcName = sys._getframe(0).f_code.co_name
    isSwitchVPC = Util.exe(VpcWrapper.isVpc(FABRIC_NAME, sn))
    if isSwitchVPC:
        try:
            vpcType = Util.exe(VpcWrapper.get(VPCMetaDataType.PEERLINK_TYPE, "", sn))
            if vpcType == VPCMetaDataType.VIRTUAL_PEERLINK:
                return True 
        except: 
            Wrapper.print("%s() template [%s] Seems Upgrade path :"%(funcName, "Easy_Fabric_Extn"))
    return False   

def isSeedSwitch(sn):
    srchOpt = CtrlPolicySearch()
    srchOpt.setSerialNumber(sn)
    srchOpt.setEntityType("SWITCH")
    srchOpt.setTemplateName("seed_switch")
    # ignore the PTI source
    ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
    isSeed = False
    if len(ptiList) > 0:
        isSeed = True

    return isSeed

def isEasyFabricInbandPoapEnabled(dictObj):
    ffType = dictObj.get("FF", "")
    if ffType != "Easy_Fabric":
        return "false"
        
    inbandMgmt = dictObj.get("INBAND_MGMT", "false")
    bootstrapPOAPEnable = dictObj.get("BOOTSTRAP_ENABLE", "false")

    return ("true" if (inbandMgmt == "true" and bootstrapPOAPEnable == "true") else "false")

def validateFabricSetting(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        FF                      = dictObj.get("FF")
        REPLICATION_MODE        = dictObj.get("REPLICATION_MODE", "Multicast")
        FABRIC_INTERFACE_TYPE   = dictObj["FABRIC_INTERFACE_TYPE"]
        LINK_STATE_ROUTING      = dictObj["LINK_STATE_ROUTING"]
        FABRIC_NAME             = dictObj["FABRIC_NAME"]
        devices                 = dictObj["DEVICES"]
        if FF == "Easy_Fabric_IPFM":
            BGP_LB_ID           = dictObj["ROUTING_LB_ID"]
            ENABLE_NBM_PASSIVE  = dictObj["ENABLE_NBM_PASSIVE"]
            ENABLE_ASM          = dictObj["ENABLE_ASM"]
        else:
            BGP_LB_ID           = dictObj["BGP_LB_ID"]
        BGP_AUTH_ENABLE         = dictObj.get("BGP_AUTH_ENABLE", "false")
        BGP_AUTH_KEY_TYPE       = dictObj.get("BGP_AUTH_KEY_TYPE", "3")
        BGP_AUTH_KEY            = dictObj.get("BGP_AUTH_KEY", "")
        OSPF_AUTH_ENABLE        = dictObj.get("OSPF_AUTH_ENABLE", "false")
        OSPF_AUTH_KEY_ID        = dictObj.get("OSPF_AUTH_KEY_ID", "127")
        OSPF_AUTH_KEY           = dictObj.get("OSPF_AUTH_KEY", "")
        ENABLE_TENANT_DHCP      = dictObj.get("ENABLE_TENANT_DHCP", "true")
        topologyDataObj         = dictObj.get("topologyObj")
        ENABLE_EVPN             = dictObj.get("ENABLE_EVPN", "true")
        MPLS_HANDOFF            = dictObj.get("MPLS_HANDOFF", "false")
        FEATURE_PTP             = dictObj.get("FEATURE_PTP", "false")
        SUPER_SPINE_BGP_AS      = dictObj.get("SUPER_SPINE_BGP_AS", "")
        ALLOW_L3VNI_NO_VLAN     = dictObj.get("ALLOW_L3VNI_NO_VLAN", "false")
        UNDERLAY_IS_V6_TMPLT_VAR = dictObj.get("UNDERLAY_IS_V6", "false")
        UNDERLAY_IS_V6 = UNDERLAY_IS_V6_TMPLT_VAR == "true"

        Wrapper.print("%s - FAB [%s] Start" % (funcName, FABRIC_NAME))
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()
        errorMsg = ""
        handle_replication_mode_change = False
        evpn_turned_off = False
        rolesWithoutTenantDhcpCfg = ["spine", "border spine", "border gateway spine", "super spine","border super spine","border gateway super spine"]
        overlayConfigPresent = Util.exe(Helper.isOverlayExist(FABRIC_NAME))
        isAnySSpInTopo = topologyDataObj.check(TopologyInfoType.IS_ANY_SUPER_SPINE_ROLE_PRESENT)
        isAnyNonSSBorderInTopo = topologyDataObj.check(TopologyInfoType.IS_ANY_BORDER_SPINE_ROLE_PRESENT)

        if isEasyFabricInbandPoapEnabled(dictObj) == "true":
            # ensure that if a spine switch is a seed.. all the other spine switches must be seeds
            eSpines = topologyDataObj.get(TopologyInfoType.SPINES)
            borderSpines = topologyDataObj.get(TopologyInfoType.BORDER_SPINES)
            borderGwSpines = topologyDataObj.get(TopologyInfoType.BORDER_GATEWAY_SPINES)
            superSpines = topologyDataObj.get(TopologyInfoType.SUPER_SPINES)
            borderSuperSpines = topologyDataObj.get(TopologyInfoType.BORDER_SUPER_SPINES)
            borderGwSuperSpines = topologyDataObj.get(TopologyInfoType.BORDER_GATEWAY_SUPER_SPINES)

            spines = filter(None, set(eSpines + borderSpines + borderGwSpines + superSpines + borderSuperSpines + borderGwSuperSpines))

            numSpines = len(spines)
            nonSeedSpines = []
            for spine in spines:
                if not isSeedSwitch(spine):
                    nonSeedSpines.append(spine)

            numNonSeedSpines = len(nonSeedSpines)
            Wrapper.print("%s - FAB [%s] numSpines [%d] numNonSeedSpines [%s] nonSeedSpines %s" % (funcName, FABRIC_NAME,
                numSpines, numNonSeedSpines, nonSeedSpines))
            if numNonSeedSpines and (numNonSeedSpines != numSpines):
                respObj.addErrorReport(getFabErrEntity(funcName, "Inband POAP: Non Seed Spines"),
                        "All spines must be seed switches with Inband POAP enabled! Please delete %s switches from the "
                        "fabric, add them back as inband POAP seed switches and retry." % (",".join(nonSeedSpines)))
                respObj.setFailureRetCode()

        if UNDERLAY_IS_V6:
            if isAnySSpInTopo and FF != "Easy_Fabric_SRv6" and FF != "Easy_Fabric_eBGP":
                respObj.addErrorReport(getFabErrEntity(funcName, "Super Spine"),
                                       "Super Spine roles are not supported with IPv6 Underlay")
                respObj.setFailureRetCode()

            for deviceSn in devices:
                if REPLICATION_MODE == "Multicast":
                    if isVirtualVPCSwitch(FABRIC_NAME, deviceSn):
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn+":IPv6 Underlay Fabric Peering"),
                            "vPC Virtual Peer Link with IPv6 Underlay and multicast replication mode is not supported", deviceSn)
                        respObj.setFailureRetCode()
                else:
                    swVersionOk = Util.isSwVersionOk(deviceSn, "10.3.2")
                    if isVirtualVPCSwitch(FABRIC_NAME, deviceSn) and not swVersionOk:
                        hostName = Util.exe(InventoryWrapper.getHostName(deviceSn))
                        nxosImage = Util.exe(ImageManagementWrapper.getNXOSVersion(deviceSn))
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn+":IPv6 Underlay Fabric Peering"),
                           "vPC Virtual Peer Link with IPv6 Underlay is supported from 10.3.2 onwards, switch %s has %s"%(hostName, nxosImage), deviceSn)
                        respObj.setFailureRetCode()

        if FABRIC_INTERFACE_TYPE == "unnumbered":
            for deviceSn in devices:
                devModel = topologyDataObj.getSwitchModel(deviceSn)
                if (devModel.startswith("N9K-C98")):
                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn+":Unnumbered Fabric Interface"),
                                           "N9K-C9800 does not support IP Unnumbered", deviceSn)
                    respObj.setFailureRetCode()

        if ALLOW_L3VNI_NO_VLAN == "false" and (FF == "Easy_Fabric" or (FF == "Easy_Fabric_eBGP" and ENABLE_EVPN == "true")):
            for deviceSn in devices:
                devModel = topologyDataObj.getSwitchModel(deviceSn)
                if (devModel.startswith("N9K-C98")):
                    switchRole = topologyDataObj.getSwitchRole(deviceSn)
                    if switchRole == "spine" or switchRole == "super spine":
                        continue

                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                                           "'Allow L3VNI w/o VLAN' in fabric settings cannot be false with the presence of N9K-C9800 VTEP", deviceSn)
                    respObj.setFailureRetCode()

        if isAnySSpInTopo: 
            if isAnyNonSSBorderInTopo:
                respObj.addErrorReport(getFabErrEntity(funcName, "Fabric with Super Spine devices"),
                                       "Border Spine or Border Gateway Spine roles switches are not allowed "
                                       "when any Super Spine role is present in the Fabric, please remove these devices from fabric to perform Recalculate Config")
                respObj.setFailureRetCode()
        
            if FF != "Easy_Fabric" and FF != "External" and FF != "Easy_Fabric_SRv6" and FF != "Easy_Fabric_eBGP" and FF != "Easy_Fabric_IOS_XE":
                respObj.addErrorReport(getFabErrEntity(funcName, FABRIC_NAME+":"+FF),
                                       "Super Spine roles are supported only in Easy Fabric, Easy Fabric eBGP, Easy Fabric IOS XE and External Fabric")
                respObj.setFailureRetCode()

            if FF == "Easy_Fabric_eBGP":
                if SUPER_SPINE_BGP_AS == "":
                    respObj.addErrorReport(getFabErrEntity(funcName, "Fabric with Super Spine devices"),
                        "Super Spine BGP AS needs to be provided with the presence of any super spine.")
                    respObj.setFailureRetCode()

        try:
            parentFabric = Util.exe(FabricWrapper.getParentFabricName(FABRIC_NAME))
            msdFabSettings = Util.exe(FabricWrapper.get(parentFabric)).getNvPairs()
            msdUnderlayV6 = msdFabSettings["VXLAN_UNDERLAY_IS_V6"] == "true"
            if UNDERLAY_IS_V6 != msdUnderlayV6:
                # must be a change in child fabric
                if UNDERLAY_IS_V6:
                    respObj.addErrorReport(getFabErrEntity(funcName, FABRIC_NAME),
                                       "Cannot change Underlay from IPv4 to IPv6 while parent fabric %s has IPv4 VXLAN underlay"%parentFabric)
                else:
                    respObj.addErrorReport(getFabErrEntity(funcName, FABRIC_NAME),
                                       "Cannot change Underlay from IPv6 to IPv4 while parent fabric %s has IPv6 VXLAN underlay"%parentFabric)
                respObj.setFailureRetCode()

            if UNDERLAY_IS_V6 and REPLICATION_MODE != "Multicast":
                respObj.addErrorReport(getFabErrEntity(funcName, FABRIC_NAME),
                                       "VXLAN fabric %s is child fabric of MSD fabric %s, thus cannot have ingress replication mode"% (FABRIC_NAME, parentFabric))
                respObj.setFailureRetCode()
        except:
            pass

        if respObj.isRetCodeFailure():
            return respObj

        for deviceSn in devices:
            switchRole = topologyDataObj.get(TopologyInfoType.GET_SWITCH_ROLE, deviceSn)
            hostName = Util.exe(InventoryWrapper.getHostName(deviceSn))

            if REPLICATION_MODE == "Ingress":
                ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_multicast_11_1"))
                ptiList += Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_pim_asm_v6"))
                if ptiList:
                    if overlayConfigPresent and ENABLE_EVPN == "true":
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                            "Cannot change Fabric Replication Mode from Multicast to Ingress with existing overlay definitions.", deviceSn)
                        respObj.setFailureRetCode()
                    else:
                        handle_replication_mode_change = True
            elif REPLICATION_MODE == "Multicast":
                ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "", "ingress_rep_simulated"))
                if ptiList:
                    if overlayConfigPresent and ENABLE_EVPN == "true":
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                            "Cannot change Fabric Replication Mode from Ingress to Multicast with existing overlay definitions.", deviceSn)
                        respObj.setFailureRetCode()
                    else:
                        handle_replication_mode_change = True

            intfName = "loopback" + BGP_LB_ID
            if UNDERLAY_IS_V6:
                if LINK_STATE_ROUTING != "ebgp":
                    lbPtiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", intfName, intfName, "loopback_interface"))
                    lbTagPtiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", intfName, intfName, "loopback_interface_with_tag"))
                    if lbPtiList or lbTagPtiList:
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                            "Cannot change Underlay from IPv4 to IPv6 with existing IPv4 config", deviceSn)
                        respObj.setFailureRetCode()
            else:
                lbPtiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", intfName, intfName, "v6_loopback_interface"))
                lbTagPtiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", intfName, intfName, "v6_loopback_interface_with_tag"))
                if lbPtiList or lbTagPtiList:
                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                        "Cannot change Underlay from IPv6 to IPv4 with existing IPv6 config", deviceSn)
                    respObj.setFailureRetCode()
            
            if not UNDERLAY_IS_V6 and MPLS_HANDOFF == "false":
                srchOpt = CtrlPolicySearch()
                srchOpt.setSerialNumber(deviceSn)
                srchOpt.setTemplateContentType("PYTHON")
                srchOpt.setTemplateName("ext_int_fabric_mpls_uplink")
                underlayPtiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                srchOpt.setTemplateName("ext_int_fabric_mpls_uplink_po")
                underlayPoPtiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                srchOpt.setTemplateContentType("TEMPLATE_CLI")
                srchOpt.setTemplateName("vxlan_mpls_overlay")
                overlayPtiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                if underlayPtiList or underlayPoPtiList or overlayPtiList:
                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                        "Cannot disable MPLS Handoff when VXLAN-to-MPLS IFCs are present on the device", deviceSn)
                    respObj.setFailureRetCode()

            if overlayConfigPresent:
                """
                # commented out till an issue with improper IFC cleanup (CSCvo40702) is fixed
                if switchRole not in rolesWithoutTenantDhcpCfg:
                    # disallow tenant DHCP setting change with overlays present
                    reportError = False
                    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "feature_dhcp"))
                    Wrapper.print("validateFabricSetting: [%s] Role [%s] DHCP, # PTIs/ENABLE_TENANT_DHCP = [%d/%s]" %
                        (deviceSn, hostName, switchRole, len(ptiList), ENABLE_TENANT_DHCP))
                    if ptiList:
                        if ENABLE_TENANT_DHCP != "true":
                            reportError = True
                    else:
                        if ENABLE_TENANT_DHCP == "true":
                            reportError = True
                    if reportError:
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                            "[%s:%s] - Cannot change Tenant DHCP settings when Overlay config is present" % (deviceSn, hostName))
                        respObj.setFailureRetCode()
                """
            if FABRIC_INTERFACE_TYPE == "unnumbered":
                template_name = "int_fabric_num_11_1"
            else:
                template_name = "int_fabric_unnum_11_1"

            srchOpt = CtrlPolicySearch()
            srchOpt.setSerialNumber(deviceSn)
            srchOpt.setTemplateName(template_name)
            srchOpt.setTemplateContentType("PYTHON")
            ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
            if ptiList:
                respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                    "Cannot change Fabric Interface Type to %s with existing %s config." % (FABRIC_INTERFACE_TYPE,
                        "p2p" if template_name == "int_fabric_num_11_1" else "unnumbered"), deviceSn)
                respObj.setFailureRetCode()

            if ENABLE_EVPN != "true" and FF == "Easy_Fabric_eBGP":
                ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_feature_leaf_evpn"))
                if ptiList:
                    evpn_turned_off = True

        if not respObj.isRetCodeSuccess():
            respObj.addErrorReport(getFabErrEntity(funcName),
                "Inconsistency between Fabric setting and existing device configuration. All errors should be resolved prior to Recalculate Config.")
            return respObj

        if evpn_turned_off:
            Wrapper.print("++++ %s, evpn turned off")
            # use the subsequent logic to clean up multicast polices and loopbacks
            handle_replication_mode_change = True
            REPLICATION_MODE = "Ingress"

        if handle_replication_mode_change:
            if REPLICATION_MODE == "Multicast":
                # IR->Mcast
                for deviceSn in devices:
                    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "", "ingress_rep_simulated"))
                    for pti in ptiList:
                        Util.exe(PTIWrapper.deleteInstance(pti.getPolicyId()))
            else:
                # Mcast->IR
                # keep "feature_pim" as removing it would cause failure on "no ip pim sparse" under interface
                for deviceSn in devices:
                    if not UNDERLAY_IS_V6:
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_multicast_11_1"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_multicast_11_1"))

                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_pim_asm_11_1"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_pim_asm_11_1"))

                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_pim_bidir_11_1"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_pim_bidir_11_1"))
                        # Clean up Bidir PTIs created by brownfield
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "", "base_pim_bidir_11_1"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "", "base_pim_bidir_11_1"))

                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "anycast_rp"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "anycast_rp"))
                    else:
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_pim_asm_v6"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "base_pim_asm_v6"))

                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "anycast_rp_v6"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "anycast_rp_v6"))

                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "tcam_preconfig_vxlanv6_pim"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "tcam_preconfig_vxlanv6_pim"))

                    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "", "rp_state"))
                    if ptiList:
                        Util.exe(PTIWrapper.delete(deviceSn, "SWITCH", "SWITCH", "", "rp_state"))

                    rpLbId = ""
                    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "", "rp_lb_id"))
                    if ptiList:
                        rpLbId = ptiList[0].nvPairs.get("id")
                        Util.exe(PTIWrapper.delete(deviceSn, "SWITCH", "SWITCH", "", "rp_lb_id"))
                        rpLbIntfName = "loopback" + rpLbId
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", rpLbIntfName, "UNDERLAY"))
                        for pti in ptiList:
                            Util.exe(PTIWrapper.deleteInstance(pti.getPolicyId()))
                        # Clean up Bidir PTIs created by brownfield
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", rpLbIntfName, ""))
                        for pti in ptiList:
                            Util.exe(PTIWrapper.deleteInstance(pti.getPolicyId()))

                    for id in range(1,5):
                        rpLbId = ""
                        templateName = "phantom_rp_lb_id" + str(id)
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "", templateName))
                        if ptiList:
                            rpLbId = ptiList[0].nvPairs.get("id")
                            Util.exe(PTIWrapper.delete(deviceSn, "SWITCH", "SWITCH", "", templateName))
                            rpLbIntfName = "loopback" + rpLbId
                            ptiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", rpLbIntfName, "UNDERLAY"))
                            for pti in ptiList:
                                Util.exe(PTIWrapper.deleteInstance(pti.getPolicyId()))
                            # Clean up Bidir PTIs created by brownfield
                            ptiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", rpLbIntfName, ""))
                            for pti in ptiList:
                                Util.exe(PTIWrapper.deleteInstance(pti.getPolicyId()))

        if FF == "Easy_Fabric_IPFM":
            for deviceSn in devices:
                # Change of NBM mode after a device is added is not allowed in NDFC 12.1(2)
                # Leave the below code in case PMN can support NBM mode change in future releases
                ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "nbm_mode"))
                if ptiList:
                    mode = ptiList[0].nvPairs.get("MODE")
                    if ((mode == "pim-active" and ENABLE_NBM_PASSIVE == "true") or
                        (mode == "pim-passive" and ENABLE_NBM_PASSIVE == "false")):
                        # There is a change of NBM mode, update all fabric interfaces to add/delete
                        # "pim passive" accordingly
                        srchOpt = CtrlPolicySearch()
                        srchOpt.setSerialNumber(deviceSn)
                        srchOpt.setTemplateName("int_ipfm_fabric_num")
                        ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                        for pti in ptiList:
                            nvPairs = copy.deepcopy(pti.getNvPairs())
                            Util.exe(PTIWrapper.updateInstance(pti.getPolicyId(), nvPairs, True))
                
                if ENABLE_NBM_PASSIVE == "true" or (ENABLE_NBM_PASSIVE == "false" and ENABLE_ASM == "false"):
                    # keep "feature_pim" as removing it would cause failure on "no ip pim sparse" under interface
                    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_pim_asm"))
                    if ptiList:
                        Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_pim_asm"))
                    else:
                        # No IPFM multicast is configured on the device, move onto the next device
                        continue
    
                    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_route_map"))
                    if ptiList:
                        Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_route_map"))
    
                    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "pim_spt_threshold"))
                    if ptiList:
                        Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "pim_spt_threshold"))

                    if topologyDataObj.getSwitchRole(deviceSn) == "spine":
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_msdp_origid"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_msdp_origid"))
        
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_msdp_peer"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "ipfm_msdp_peer"))

                        rpLbId = ""
                        ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "", "rp_lb_id"))
                        if ptiList:
                            rpLbId = ptiList[0].nvPairs.get("id")
                            Util.exe(PTIWrapper.delete(deviceSn, "SWITCH", "SWITCH", "", "rp_lb_id"))
                            rpLbIntfName = "loopback" + rpLbId
                            ptiList = Util.exe(PTIWrapper.get(deviceSn, "INTERFACE", rpLbIntfName, "UNDERLAY"))
                            for pti in ptiList:
                                Util.exe(PTIWrapper.deleteInstance(pti.getPolicyId()))

                    # Update all routed interfaces to delete pim config from the interface
                    srchOpt = CtrlPolicySearch()
                    srchOpt.setSerialNumber(deviceSn)
                    srchOpt.setTemplateName("int_ipfm_l3_port")
                    ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                    srchOpt.setTemplateName("int_ipfm_vlan")
                    ptiList += Util.exe(PTIWrapper.getPTIs(srchOpt))
                    for pti in ptiList:
                        nvPairs = copy.deepcopy(pti.getNvPairs())
                        Util.exe(PTIWrapper.updateInstance(pti.getPolicyId(), nvPairs, True))
    except Exception as e:
        Wrapper.print("%s - FAB [%s] Exception [%s]" % (funcName, FABRIC_NAME, e))
        if isinstance(e, respObjError):
            Util.processRespObj(respObj, e.value)
        else:
            Util.handleException(("Unexpected error validating fabric settings. Please retry and if "
                "issue persists, contact Cisco TAC"), e, respObj)
    finally:
        Wrapper.print("%s - FAB [%s] Finish. Success = [%r]" % (funcName, FABRIC_NAME, respObj.isRetCodeSuccess()))
        return respObj

def validateManageabilityTabSettings(dictObj):

    DNS_SERVER_IP_LIST      = dictObj["DNS_SERVER_IP_LIST"]
    DNS_SERVER_VRF          = dictObj["DNS_SERVER_VRF"]
    NTP_SERVER_IP_LIST      = dictObj["NTP_SERVER_IP_LIST"]
    NTP_SERVER_VRF          = dictObj["NTP_SERVER_VRF"]
    SYSLOG_SERVER_IP_LIST   = dictObj["SYSLOG_SERVER_IP_LIST"]
    SYSLOG_SEV              = dictObj["SYSLOG_SEV"]
    SYSLOG_SERVER_VRF       = dictObj["SYSLOG_SERVER_VRF"]

    Wrapper.print("======== validateManageabilityTabSettings ==========")
    respObj = WrappersResp.getRespObj()
    respObj.setSuccessRetCode()

    # Validate DNS Server input
    if DNS_SERVER_IP_LIST:
        DNSipList   =   []
        DNSvrfList  =   []

        # Skip whitespace and split string by comma
        DNSipList = [eachIP.strip() for eachIP in DNS_SERVER_IP_LIST.split(',')]
        DNSvrfList = [eachvrf.strip() for eachvrf in DNS_SERVER_VRF.split(',')]
       
        inputStatusDNS = getComparisonStatusIP_VRFS(DNSipList, DNSvrfList)

        if(inputStatusDNS == None or inputStatusDNS == -1 or len(DNSvrfList) < 1 ):
            Wrapper.print("DNS Error")
            ipLenDNS = str(len(DNSipList))
            vrfLenDNS = str(len(DNSvrfList))
            respObj.addErrorReport("DNS Server Settings",
                "Incorrect number of DNS Server IPs [Count = %s] and DNS Server VRFs [Count = %s] . Please maintain many to one or one to one mapping of DNS Server IPs and DNS Server VRFs respectively." % (ipLenDNS, vrfLenDNS))
            respObj.setFailureRetCode()

        if inputStatusDNS == 1:
            ipLenDNS = str(len(DNSipList))
            DNSVrf = DNSvrfList[0]
             # Maximum number of Ip addresses per vrf is 6
            if len(DNSipList) > 6:
                respObj.addErrorReport("DNS Server Settings",
                    "Incorrect number of DNS Server IPs [Count = %s] for vrf : %s. Maximum number of DNS Server IPs per vrf is 6." % (ipLenDNS, DNSVrf))
                respObj.setFailureRetCode()
        else:
            # Create a dictionary to account for ips under same vrfs
            DNS_IPdict = {}
            for ip, vrf in zip(DNSipList, DNSvrfList):
                Wrapper.print(str(ip) + " " + str(vrf))
                if vrf in DNS_IPdict:
                    dnsList = DNS_IPdict.get(vrf)
                    dnsList.append(ip)
                    # Maximum number of Ip addresses per vrf is 6
                    if len(dnsList) > 6:
                        ipLenDNS = str(len(dnsList))
                        respObj.addErrorReport("DNS Server Settings",
                            "Incorrect number of DNS Server IPs [Count = %s] for vrf : %s. Maximum number of DNS Server IPs per vrf is 6." % (ipLenDNS, vrf))
                        respObj.setFailureRetCode()
                else:
                    dnsList = []
                    dnsList.append(ip)
                    DNS_IPdict[vrf] = dnsList
                    Wrapper.print(str(DNS_IPdict))
                
    # Validate NTP Server input
    if NTP_SERVER_IP_LIST:
        NTPipList   =   []
        NTPvrfList  =   [] 

        # Skip whitespace and split string by comma
        NTPipList = [eachIP.strip() for eachIP in NTP_SERVER_IP_LIST.split(',')]
        NTPvrfList = [eachvrf.strip() for eachvrf in NTP_SERVER_VRF.split(',')]
        
        inputStatusNTP = getComparisonStatusIP_VRFS(NTPipList, NTPvrfList)
        Wrapper.print(str(inputStatusNTP))

        if(inputStatusNTP == None or inputStatusNTP == -1 or len(NTPvrfList) < 1 ):
            Wrapper.print("NTP Error")
            ipLenNTP = str(len(NTPipList))
            vrfLenNTP = str(len(NTPvrfList))
            respObj.addErrorReport("NTP Server Settings",
                "Incorrect number of NTP Server IPs [Count = %s] and NTP Server VRFs [Count = %s] . Please maintain many to one or one to one mapping of NTP Server IPs and NTP Server VRFs respectively." % (ipLenNTP, vrfLenNTP))
            respObj.setFailureRetCode()
        
    # Validate SYSLOG Server input
    
    if SYSLOG_SERVER_IP_LIST:
        SYSipList   =   []
        SYSvrfList  =   []
        SYSsevList  =   []
        # Skip whitespace and split string by comma
        SYSipList  = [eachIP.strip() for eachIP in SYSLOG_SERVER_IP_LIST.split(',')]
        SYSvrfList = validateSyslogVrf(SYSLOG_SERVER_VRF, respObj)
        SYSsevList = validateSyslogSeverity(SYSLOG_SEV, respObj)
        if respObj.isRetCodeFailure():
            return respObj

        # Check for valid number of IP , vrfs and Severity
        inputStatusSYSVrf = getComparisonStatusIP_VRFS(SYSipList, SYSvrfList)
        inputStatusSYSSev = getComparisonStatusIP_SEV(SYSipList,SYSsevList)
        
        if(inputStatusSYSVrf == None or inputStatusSYSVrf == -1 or len(SYSvrfList) < 1 or inputStatusSYSSev == None or inputStatusSYSSev == -1 or len(SYSvrfList) < 1):
            Wrapper.print("SYSLOG Error")
            ipLenSYS = str(len(SYSipList))
            vrfLenSYS = str(len(SYSvrfList))
            sevLenSYS = str(len(SYSsevList))
            respObj.addErrorReport("SYSLOG Server Settings",
                "Incorrect number of Syslog Server IPs [Count = %s], Syslog Server VRFs [Count = %s], Syslog Severity [Count = %s] . Please maintain many to one or one to one mapping of Syslog Server IPs and Syslog Server VRFs and Syslog Severity respectively." % (ipLenSYS, vrfLenSYS, sevLenSYS))
            respObj.setFailureRetCode()

        # Maximum number of syslog servers that can be configured is 8
        if len(SYSipList) > 8:
            ipLenSYS = str(len(SYSipList))
            respObj.addErrorReport("SYSLOG Server Settings",
                "Incorrect number of Syslog Server IPs [Count = %s]. Maximum number of Syslog servers IPs that can be configured is 8." % (ipLenSYS))
            respObj.setFailureRetCode()

        uniqueSysIps = []
        duplicateSysIps = []
        for sysIp in SYSipList:
            if sysIp not in uniqueSysIps:
                uniqueSysIps.append(sysIp)
            else:
                if sysIp not in duplicateSysIps:
                    duplicateSysIps.append(sysIp)
        if len(duplicateSysIps) > 0:
            respObj.addErrorReport("SYSLOG Server Settings",
                "Found duplicate IPs in the 'Syslog Server IPs' list, please remove duplicate IPs %s from the list." % duplicateSysIps)
            respObj.setFailureRetCode()

    Wrapper.print("====== end of validateManageabilityTabSettings =======")
    return respObj

