        Util.exe(PTIWrapper.markDelete(deviceSn, "SWITCH", "SWITCH", source, template_name))

def cleanUpAAAPtis(deviceSn, template_name,source):
    Wrapper.print(str(deviceSn) + " " + str(source) + " " + str(template_name))
    Wrapper.print("cleanUpAAAPtis for AAA")
    ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", source, template_name))
    for eachPti in ptiList:
        Wrapper.print(str(eachPti.getPolicyId()))
        try:
            if eachPti.getDescription() == AAA_CONF_DESCRIPTION:
                Util.exe(PTIWrapper.deleteInstance(eachPti.getPolicyId()))
                Wrapper.print("clean up AAA configurations: " + str(eachPti.getPolicyId()))
        except:
            Wrapper.print("No clean needed")

def capture_po_member_interface_ptis (dictObj):
    try:
        respObj = WrappersResp.getRespObj()

        #Need to capture desc and FF of port channel member interfaces if any
        Wrapper.print("capture_po_member_interface_ptis: %s" % dictObj)

        MEMBER_INTERFACES = dictObj["MEMBER_INTERFACES"]
        SERIAL_NUMBER = dictObj["SERIAL_NUMBER"]

        memberInterfaces = None
        if MEMBER_INTERFACES != "":
            memberInterfaceList = Util.expand_interface_range(MEMBER_INTERFACES)
            memberInterfaces = memberInterfaceList.split(",")

        memberDescDict = {}
        memberConfDict = {}
        memberAdminStateDict = {}
        if memberInterfaces != None:
            for interface in memberInterfaces:
                intfptiList = Util.exe(PTIWrapper.getPTIs(SERIAL_NUMBER, "INTERFACE", interface, "PYTHON"))
                for intfpti in intfptiList:
                    templateName = intfpti.getTemplateName()
                    if templateName == "int_l3_port_channel_member" or templateName == "int_l3_port_channel_member_internal":
                        memberDescDict[interface]  = intfpti.getNvPairs()["DESC"]
                        memberConfDict[interface]  = intfpti.getNvPairs()["CONF"]
                        memberAdminStateDict[interface]  = intfpti.getNvPairs()["ADMIN_STATE"]
                        Wrapper.print("l3 po: Capturing intf %s adminState %s desc %s conf %s" %
                                      (str(interface), str(memberAdminStateDict[interface]), str(memberDescDict[interface]), str(memberConfDict[interface])))
                        break
                    if (templateName == "int_access_host" or 
                        templateName == "int_dot1q_tunnel_host" or
                        templateName == "int_routed_host" or
                        templateName == "int_trunk_host"):
                        memberDescDict[interface]  = intfpti.getNvPairs()["DESC"]
                        memberAdminStateDict[interface]  = intfpti.getNvPairs()["ADMIN_STATE"]
                        break

        respObj.setSuccessRetCode()
        returnDict = {"memberInterfaces": memberInterfaces, "memberDescDict": memberDescDict, "memberConfDict": memberConfDict, "memberAdminStateDict": memberAdminStateDict}
        respObj.setValue(returnDict)
        return respObj
    except respObjError as e:
        return e.value


def create_po_member_interface_ptis (dictObj):
    try:
        respObj = WrappersResp.getRespObj()

        Wrapper.print("create_po_member_interface_ptis: %s" % dictObj)
        SERIAL_NUMBER = dictObj["SERIAL_NUMBER"]
        IF_NAME = dictObj["IF_NAME"]
        memberInterfaces = dictObj["memberInterfaces"]
        memberDescDict = dictObj["memberDescDict"]
        memberConfDict = dictObj["memberConfDict"]
        memberAdminStateDict = dictObj["memberAdminStateDict"]
        pcMemTemplateName = dictObj["pcMemTemplateName"]

        if memberInterfaces != None:
            for interface in memberInterfaces:
                #Create desc and FF PTI for port-channel member interfaces
                memberDesc = memberDescDict.get(interface, "")
                memberConf = memberConfDict.get(interface, "")
                memberAdminState = memberAdminStateDict.get(interface, "true")

                if memberDesc != "" or memberConf != "" or memberAdminState != "true":
                    Wrapper.print("l3 po: Creating intf %s desc %s" % (str(interface), str(memberDescDict[interface])))

                    ptiList = Util.exe(PTIWrapper.getPTIs(SERIAL_NUMBER, "INTERFACE", interface, "PYTHON"))
                    for pti in ptiList:
                        Wrapper.print("L3 Po member case %s %s" % (IF_NAME, interface))
                        if pti.getTemplateName() == pcMemTemplateName:
                            l3_po_member_nvPairs = copy.deepcopy(pti.getNvPairs())
                            #Create new L3 Po PTI with updated nvPairs
                            Wrapper.print("Update L3 Po member: Existing NV Pairs [%s]]" % str(l3_po_member_nvPairs))
                            l3_po_member_nvPairs["CONF"] = memberConf
                            l3_po_member_nvPairs["DESC"] = memberDesc
                            l3_po_member_nvPairs["ADMIN_STATE"] = memberAdminState

                            Util.exe(PTIWrapper.createOrUpdate(SERIAL_NUMBER, "INTERFACE",
                                                       interface, IF_NAME.lower(),
                                                       ConfigPriority.CONFIG_PRIO_INTF,
                                                       pcMemTemplateName,
                                                       l3_po_member_nvPairs))
                            break

        respObj.setSuccessRetCode()
        return respObj
    except respObjError as e:
        return e.value

def check_po_member(dictObj):
    try:
        respObj = WrappersResp.getRespObj()
        SERIAL_NUMBER = dictObj["SERIAL_NUMBER"]
        IF_NAME = dictObj["IF_NAME"]

        Wrapper.print("check port-channel membership [%s, %s]" % (SERIAL_NUMBER, IF_NAME))
        interfaceResp = InterfaceManagerWrapper.isPortchannelMember(SERIAL_NUMBER, IF_NAME)
        if interfaceResp.isRetCodeSuccess():
            if interfaceResp.getValue() == True:
                errorMsg = ("IFC cannot be created on %s as it is a member of a portchannel" % (IF_NAME))
                Wrapper.print(errorMsg)
                respObj.addErrorReport(("Error"), errorMsg)
                respObj.setFailureRetCode()
                return respObj
        else:
            errorMsg = ("Invalid interface wrapper response for %s %s" %(SERIAL_NUMBER, IF_NAME))
            Wrapper.print(errorMsg)
            respObj.addErrorReport(("Error"), errorMsg)
            respObj.setFailureRetCode()
            return respObj

        respObj.setSuccessRetCode()
        return respObj
    except respObjError as e:
        return e.value

def getNonEmptyValue(dictObj, varName, defVal):
    val = dictObj.get(varName, defVal)
    if (val == ""):
        val = defVal
    return val

#
# This API generates the following config for the specified set of devices
#   - SNMP configuration if GEN_SNMP is present
#   - NX-API configuration if GEN_NXAPI is present
#
# Input in dictObj:
#    FABRIC_NAME    - Mandatory - String - name of the fabric
#    SERIAL_LIST    - Mandatory - list of serial # strings to generate the config for
#    TOPOLOGY       - Mandatory - topology object
#    FABRIC_SETTINGS- Optional  - Current fabric settings. Will be fetched if not specified
#    GEN_SNMP       - Optional dictionary. if present, SNMP config will be generated
#                     {"SNMP_INFO" : snmpInfoDict}
#    GEN_NXAPI      - Optional dictionary. if present, NX-API config will be generated
#                     {}
#
def genCommonAllDeviceConfig(dictObj):
    funcName = sys._getframe(0).f_code.co_name
    respObj = WrappersResp.getRespObj()
    respObj.setSuccessRetCode()

    fabricName = dictObj.get("FABRIC_NAME", None)
    serialList = dictObj.get("SERIAL_LIST", None)
    fabricSettings = dictObj.get("FABRIC_SETTINGS", None)
    genSnmp = dictObj.get("GEN_SNMP", None)
    genNxapi = dictObj.get("GEN_NXAPI", None)
    topologyDataObj = dictObj.get("TOPOLOGY", None)

    generateSnmp = False
    generateNxapi = False

    try:
        if ((serialList is None) or (topologyDataObj is None)):
            respObj.addErrorReport(funcName + "Invalid data", ("Fabric [%s]: Invalid data encountered during SNMP "
                "and NX-API configuration generation. Please retry and contact Cisco TAC if issue persists." % (fabricName)))
            respObj.setFailureRetCode()
            return respObj

        if (len(serialList) == 0):
            return respObj

        if not fabricSettings:
            fabricSettings = Util.exe(FabricWrapper.get(fabricName)).getNvPairs()

        ff = fabricSettings.get("FF", "")

        enableRtIntfStats = (fabricSettings.get("ENABLE_RT_INTF_STATS", "false") == "true")
        if enableRtIntfStats:
            intfStatsloadInterval = getNonEmptyValue(fabricSettings, "INTF_STAT_LOAD_INTERVAL", "10")

        if genNxapi is not None:
            generateNxapi = True
            enableNxapi = fabricSettings.get("ENABLE_NXAPI", "false")
            enableNxapiHttp = fabricSettings.get("ENABLE_NXAPI_HTTP", "false")
            nxapiHttpsPort = getNonEmptyValue(fabricSettings, "NXAPI_HTTPS_PORT", "443")
            nxapiHttpPort = getNonEmptyValue(fabricSettings, "NXAPI_HTTP_PORT", "80")
            genNxapiVrf = "NXAPI_VRF" in fabricSettings
            if genNxapiVrf:
                nxapiVrf = fabricSettings.get("NXAPI_VRF", "management")
    
        if genSnmp is not None:
            generateSnmp = True
            snmpInfoObj = genSnmp.get("SNMP_INFO", None)
            if snmpInfoObj is None:
                # report an error
                respObj.addErrorReport(funcName + "Missing SNMP Info", ("Fabric [%s] Missing SNMP information." % (fabricName)))
                respObj.setFailureRetCode()
                return respObj
            snmpInfo = json.loads(snmpInfoObj)
            Wrapper.print("%s: NDFC SNMP properties %s" % (funcName, json.dumps(snmpInfo, indent=4, sort_keys=True)))
    
            gblSnmpServerHost = fabricSettings.get("SNMP_SERVER_HOST_TRAP", "false")

        for swSerial in serialList:
            devModel = topologyDataObj.getSwitchModel(swSerial)
            isNXOS = Util.isNXOSDevice(swSerial, devModel)

            cleanupRtLoadInterval = True
            if enableRtIntfStats:
                if isNXOS:
                    if Util.isSwVersionOk(swSerial, "10.4(3)"):
                        # generate the intent - min version is NX-OS 10.4(3)
                        Util.exe(PTIWrapper.createOrUpdate(swSerial, "SWITCH", "SWITCH", "UNDERLAY",
                            ConfigPriority.CONFIG_PRIO_TOP, TEMPLATE_DME_INTF_STATS_LOAD_INTERVAL, {"INTERVAL" : intfStatsloadInterval}))
                        cleanupRtLoadInterval = False

            if cleanupRtLoadInterval:
                ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "UNDERLAY", TEMPLATE_DME_INTF_STATS_LOAD_INTERVAL))
                if ptiList:
                    Util.exe(PTIWrapper.markDelete(swSerial, "SWITCH", "SWITCH", "UNDERLAY", TEMPLATE_DME_INTF_STATS_LOAD_INTERVAL))

            if (gblSnmpServerHost == "true"):
                # generate the SNMP trap host IP based on the OOB network mode 
                # Fetch IPv4 or IPv6 address based on discovered IP of the switch
                deviceIP = Util.exe(Helper.getSeedIp(swSerial))
                if Util.isIpv6Addr(deviceIP):
                    dataTrapIP = snmpInfo.get("data_trap_ipv6", None)
                    mgmtTrapIP = snmpInfo.get("mgmt_trap_ipv6", None)
                else:
                    dataTrapIP = snmpInfo.get("data_trap_ip", None)
                    mgmtTrapIP = snmpInfo.get("mgmt_trap_ip", None)
                oobNwMode = snmpInfo.get("global.oob_network_mode")
                trapIp = None
                if oobNwMode == "Data":
                    trapIp = dataTrapIP
                else:
                    trapIp = mgmtTrapIP

                if trapIp is None:
                    # report an error
                    respObj.addErrorReport(funcName + "Common Config Gen",
                               ("NDFC [%s] SNMP Trap IP Address is not configured. Please configure and retry." % (oobNwMode)))
                    respObj.setFailureRetCode()
                    return respObj

                setSNMPV3Trap = False if snmpInfo.get("core.trap_v3enable", "true") == "false" else True
                snmpSendPort = snmpInfo.get("global.trap_port", "2162")
                snmpV2CommString = snmpInfo.get("global.snmp_defaultCommunity", "public")

            genForNonNXOS = False
            if ff != "Easy_Fabric_IOS_XE":
                templateName = "snmp_server_host_trap"
            else:
                if dictObj.get("IS_IOS_XE") == "true":
                    templateName = "ios_xe_snmp_server_host_trap"
                    genForNonNXOS = True
                else:
                    templateName = "snmp_server_host_trap"

            # generate Nx-API only for NX-OS switches
            if generateNxapi and isNXOS:
                if enableNxapi == "true":
                    Util.exe(PTIWrapper.createOrUpdate(swSerial, "SWITCH", "SWITCH", "UNDERLAY",
                                                ConfigPriority.CONFIG_PRIO_TOP, "feature_nxapi", {}))
                    
                    if genNxapiVrf:
                        Util.exe(PTIWrapper.createOrUpdate(swSerial, "SWITCH", "SWITCH", "UNDERLAY",
                                                    ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP,
                                                    "nxapi_vrf", {"NXAPI_VRF": nxapiVrf}))

                    # NXAPI is always enabled on HTTPS port, create the HTTPS policy if one has not been created.
                    Util.exe(PTIWrapper.createOrUpdate(swSerial, "SWITCH", "SWITCH", "",
                                                ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP,
                                                "nxapi_https_port", {"PORT_NUMBER": nxapiHttpsPort}))

                    # If NXAPI on HTTP port is enabled, create the HTTP policy if one has not been created.
                    if enableNxapiHttp == "true":
                        Util.exe(PTIWrapper.createOrUpdate(swSerial, "SWITCH", "SWITCH", "",
                                                    ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP,
                                                    "nxapi_http_port", {"PORT_NUMBER": nxapiHttpPort}))
                    else:
                        # NXAPI on HTTP port is disabled
                        if devModel.startswith("N9K-") or devModel.startswith("N3K-"):
                            # Check the NXOS release, http config can only be removed from release 9.2(1) and later releases
                            ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "", "nxapi_http_port"))
                            if ptiList:
                                isSwVersion92 = Util.isSwVersionOk(swSerial, "9.2(1)")
                                if isSwVersion92:
                                    Util.exe(PTIWrapper.markDelete(swSerial, "SWITCH", "SWITCH", "", "nxapi_http_port"))
                                else:
                                    Util.exe(PTIWrapper.delete(swSerial, "SWITCH", "SWITCH", "", "nxapi_http_port"))
                else:
                    ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "UNDERLAY", "feature_nxapi"))
                    if ptiList:
                        Util.exe(PTIWrapper.markDelete(swSerial, "SWITCH", "SWITCH", "UNDERLAY", "feature_nxapi"))
                    if genNxapiVrf:
                        ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "UNDERLAY", "nxapi_vrf"))
                        if ptiList:
                            Util.exe(PTIWrapper.markDelete(swSerial, "SWITCH", "SWITCH", "UNDERLAY", "nxapi_vrf"))
                    ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "", "nxapi_https_port"))
                    if ptiList:
                        Util.exe(PTIWrapper.markDelete(swSerial, "SWITCH", "SWITCH", "", "nxapi_https_port"))
                    ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "", "nxapi_http_port"))
                    if ptiList:
                        Util.exe(PTIWrapper.markDelete(swSerial, "SWITCH", "SWITCH", "", "nxapi_http_port"))

            if generateSnmp:
                if (not isNXOS and not genForNonNXOS):
                    continue
                
                if (gblSnmpServerHost == "true"):
                    # get the switch info that has the discovery vrf and intf
                    swInfo = Util.exe(InventoryWrapper.getSwitchInfo(fabricName, swSerial))
                    srcVrf = swInfo.getSwitchDO().getSourceVrf()
                    srcIntf = swInfo.getSwitchDO().getSourceInterface()
                    Wrapper.print("%s: swSerial [%s] srcVrf [%s] srcIntf [%s]" % (funcName, swSerial, srcVrf, srcIntf))
                    if ((srcVrf is None) or (srcVrf == "") or (srcVrf.lower() == "management")):
                        # extra config is not needed for mgmt vrf
                        srcVrf = ""
                        srcIntf = ""

                    if ((srcIntf is not None) and (srcIntf.lower().startswith("loopback"))):
                        # switch expects lower case loopback intf name
                        srcIntf = srcIntf.lower()

                    if setSNMPV3Trap:
                        commStr = Util.exe(Helper.getDiscoveryUser(swSerial))
                        snmpVer = "3"
                    else:
                        commStr = snmpV2CommString
                        snmpVer = "2c"

                    Wrapper.print("%s: swSerial [%s] oobNwMode [%s] mgmtTrapIP [%s] dataTrapIP [%s] Sw [%s] trapIp [%s] "
                        "srcVrf [%s] srcIntf [%s] SNMP ver [%s] Community String [%s] port [%s]" % (funcName, swSerial,
                            oobNwMode, mgmtTrapIP, dataTrapIP, swSerial, trapIp, srcVrf, srcIntf, snmpVer, commStr, snmpSendPort))

                createSnmpPti = False
                foundMatch = False
                ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "UNDERLAY", templateName))
                if ptiList:
                    for pti in ptiList:
                        if pti.isDeleted():
                            continue

                        Wrapper.print("%s: Processing PTI [%s] nvpairs [%s]" % (funcName, pti.getPolicyId(), pti.getNvPairs()))

                        if (gblSnmpServerHost == "false"):
                            PTIWrapper.markDeleteInstance(pti.getPolicyId())
                            continue

                        if ((trapIp != pti.nvPairs.get("IP")) or (snmpVer != pti.nvPairs.get("VER")) or
                            (commStr != pti.nvPairs.get("CS")) or (snmpSendPort != pti.nvPairs.get("UDP_PORT")) or
                            (srcIntf != pti.nvPairs.get("SRC_INTF") or (srcVrf != pti.nvPairs.get("VRF")))):
                            PTIWrapper.markDeleteInstance(pti.getPolicyId())
                            if not foundMatch:
                                createSnmpPti = True
                        else:
                            foundMatch = True
                            createSnmpPti = False
                else:
                    # no PTIs exist currently
                    createSnmpPti = True

                if (gblSnmpServerHost == "true"):
                    if not createSnmpPti and not foundMatch:
                        # This can occur in this sequence:
                        #  - setting is enabled with the trap host config deploy
                        #  - disable + S & D (PTI will be mark deleted)
                        #  - enable + S & D
                        createSnmpPti = True
                    if createSnmpPti:
                        Util.exe(PTIWrapper.create(swSerial, "SWITCH", "SWITCH", "UNDERLAY",
                                                    ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP, templateName,
                                                    {"IP":trapIp, "VER":snmpVer, "CS":commStr, "UDP_PORT":snmpSendPort,
                                                    "SRC_INTF" : srcIntf, "VRF" : srcVrf}))
    except Exception as e:
        Wrapper.print("%s - FAB [%s] Exception [%s]" % (funcName, fabricName, e))
        if isinstance(e, respObjError):
            Util.processRespObj(respObj, e.value)
        else:
            Util.handleException("Unexpected error. Please retry.", e, respObj)
    finally:
        Wrapper.print("%s - FAB [%s] Finish. Success = [%r]" % (funcName, fabricName, respObj.isRetCodeSuccess()))
        return respObj

#
# Manages the SNMP trap config for a given switch
# Input in dictObj:
#    FABRIC_NAME    - Mandatory - name of the fabric
#    SERIAL         - Mandatory - switch serial
#    SNMP_INFO      - Mandatory - NDFC SNMP Trap info
#    FABRIC_SETTINGS- Optional  - Current fabric settings. Will be obtained if not specified
#
def manageSnmpTrapHostPolicy(dictObj):
    funcName = sys._getframe(0).f_code.co_name
    respObj = WrappersResp.getRespObj()
    respObj.setSuccessRetCode()

    fabricName = dictObj.get("FABRIC_NAME", None)
    swSerial = dictObj.get("SERIAL", None)

    Wrapper.print("%s - FAB [%s] Sw [%s] Start" % (funcName, fabricName, swSerial))

    try:
        snmpInfoObj = dictObj.get("SNMP_INFO", None)
        if snmpInfoObj is None:
            return respObj
        snmpInfo = json.loads(snmpInfoObj)
        Wrapper.print("%s: NDFC SNMP properties %s" % (funcName, json.dumps(snmpInfo, indent=4, sort_keys=True)))

        fabricSettings = dictObj.get("FABRIC_SETTINGS", None)
        if not fabricSettings:
            fabricSettings = Util.exe(FabricWrapper.get(fabricName)).getNvPairs()
        gblSnmpServerHost = fabricSettings.get("SNMP_SERVER_HOST_TRAP", "false")

        ff = Util.exe(FabricWrapper.get(fabricName, "FF"))
        if ff != "Easy_Fabric_IOS_XE":
            templateName = "snmp_server_host_trap"
        else:
            if dictObj.get("IS_IOS_XE") == "true":
                templateName = "ios_xe_snmp_server_host_trap"
            else:
                templateName = "snmp_server_host_trap"

        # Wrapper.print("%s: gblSnmpServerHost [%s]" % (funcName, gblSnmpServerHost))
        if (gblSnmpServerHost == "true"):
            # generate the SNMP trap host IP based on the OOB network mode
            # Fetch IPv4 or IPv6 address based on discovered IP of the switch
            deviceIP = Util.exe(Helper.getSeedIp(swSerial))
            if Util.isIpv6Addr(deviceIP):
                dataTrapIP = snmpInfo.get("data_trap_ipv6", None)
                mgmtTrapIP = snmpInfo.get("mgmt_trap_ipv6", None)
            else:
                dataTrapIP = snmpInfo.get("data_trap_ip", None)
                mgmtTrapIP = snmpInfo.get("mgmt_trap_ip", None)
            
            oobNwMode = snmpInfo.get("global.oob_network_mode")
            trapIp = None
            if oobNwMode == "Data":
                trapIp = dataTrapIP
            else:
                trapIp = mgmtTrapIP

            Wrapper.print("%s: oobNwMode [%s] mgmtTrapIP [%s] dataTrapIP [%s] Sw [%s] trapIp [%s]" % (funcName, 
                                                oobNwMode, mgmtTrapIP, dataTrapIP, swSerial, trapIp))

            if trapIp is None:
                # report an error
                respObj.addErrorReport(getFabErrEntity(funcName, swSerial),
                           ("NDFC [%s] SNMP Trap IP Address is not configured. Please configure and retry." % (oobNwMode)))
                respObj.setFailureRetCode()
                return respObj

            setSNMPV3Trap = False if snmpInfo.get("core.trap_v3enable", "true") == "false" else True
            snmpSendPort = snmpInfo.get("global.trap_port", "2162")
            snmpV2CommString = snmpInfo.get("global.snmp_defaultCommunity", "public")
            if setSNMPV3Trap:
                commStr = Util.exe(Helper.getDiscoveryUser(swSerial))
                Wrapper.print("%s: getDiscoveryUser: commStr [%s]" % (funcName, commStr))
                # hardcode to 'admin' till the above API returns the correct data
                # commStr = "admin"
                snmpVer = "3"
            else:
                commStr = snmpV2CommString
                snmpVer = "2c"
            Wrapper.print("%s: Trap IP [%s] SNMP ver [%s] Community String [%s] port [%s]" % (funcName, trapIp, snmpVer, commStr, snmpSendPort))

        createSnmpPti = False
        foundMatch = False
        ptiList = Util.exe(PTIWrapper.get(swSerial, "SWITCH", "SWITCH", "UNDERLAY", templateName))
        if ptiList:
            for pti in ptiList:
                if pti.isDeleted():
                    continue

                Wrapper.print("%s: Processing PTI [%s] nvpairs [%s]" % (funcName, pti.getPolicyId(), pti.getNvPairs()))

                if (gblSnmpServerHost == "false"):
                    PTIWrapper.markDeleteInstance(pti.getPolicyId())
                    continue

                if ((trapIp != pti.nvPairs.get("IP")) or (snmpVer != pti.nvPairs.get("VER")) or
                    (commStr != pti.nvPairs.get("CS")) or (snmpSendPort != pti.nvPairs.get("UDP_PORT"))):
                    PTIWrapper.markDeleteInstance(pti.getPolicyId())
                    if not foundMatch:
                        createSnmpPti = True
                else:
                    foundMatch = True
                    createSnmpPti = False
        else:
            # no PTIs exist currently
            createSnmpPti = True

        if (gblSnmpServerHost == "true"):
            if not createSnmpPti and not foundMatch:
                # This can occur in this sequence:
                #  - setting is enabled with the trap host config deploy
                #  - disable + S & D (PTI will be mark deleted)
                #  - enable + S & D
                createSnmpPti = True
            if createSnmpPti:
                Util.exe(PTIWrapper.create(swSerial, "SWITCH", "SWITCH", "UNDERLAY",
                                ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP, templateName,
                                {"IP":trapIp, "VER":snmpVer, "CS":commStr, "UDP_PORT":snmpSendPort}))
    except Exception as e:
        Wrapper.print("%s - FAB [%s] Sw [%s] Exception [%s]" % (funcName, fabricName, swSerial, e))
        if isinstance(e, respObjError):
            Util.processRespObj(respObj, e.value)
        else:
            Util.handleException(("Unexpected error creating SNMP Trap Host Policy for switch [%s]. Please retry and if "
                "issue persists, contact Cisco TAC") % (swSerial), e, respObj)
    finally:
        Wrapper.print("%s - FAB [%s] Sw [%s] Finish. Success = [%r]" % (funcName, fabricName, swSerial, respObj.isRetCodeSuccess()))
        return respObj

def isDeviceTmpltPresent(deviceSn, templateName):
    srchOpt = CtrlPolicySearch()
    srchOpt.setSerialNumber(deviceSn)
    srchOpt.setTemplateName(templateName)
    ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
    pti_found = False
    for pti in ptiList:
        if pti.isDeleted():
            continue
        pti_found = True
        break
    return pti_found

def isIntfTmpltConfigPresent(deviceSn, templateName):
    srchOpt = CtrlPolicySearch()
    srchOpt.setSerialNumber(deviceSn)
    srchOpt.setEntityType("INTERFACE")
    srchOpt.setTemplateContentType("PYTHON")
    ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
    pti_found = False
    for pti in ptiList:
        if pti.isDeleted():
            continue
        if "interface_ipv4_netflow" in templateName and "ip flow monitor" in pti.getGeneratedConfig():
            pti_found = True
            break
        if "interface_l2_netflow" in templateName and "layer2-switched flow monitor" in pti.getGeneratedConfig():
            pti_found = True
            break
    return pti_found

