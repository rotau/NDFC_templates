def configureDNS(respObj,deviceSn, DNS_SERVER_IP_LIST,DNS_SERVER_VRF,CONFIG_PRIORITY_DNS_VRF):
    
    Wrapper.print("configureDNS: Switch [%s] DNS_SERVER_IP_LIST [%s]" % (deviceSn, DNS_SERVER_IP_LIST))
    
    # Search all the existing policies which needs to be deleted
    srchOpt = CtrlPolicySearch()
    srchOpt.setSerialNumber(deviceSn)
    srchOpt.setSource("UNDERLAY")
    srchOpt.setTemplateName("dns-vrfList")
    ptis = Util.exe(PTIWrapper.getPTIs(srchOpt))
    srchOpt.setTemplateName("dnsList")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))

    if DNS_SERVER_IP_LIST == '':
        for pti in ptis:
            PTIWrapper.markDeleteInstance(pti.getPolicyId())
        return respObj
    else:
        # first time DNS is configured in the fabric setting tab.. cleanup all old policies that could exist 
        # pre-upgarde and/or user created ones from View/Edit policies
        deleteExistingPoliciesDNS(deviceSn)
    
    DNSipList   =   []
    DNSvrfList  =   []

    # Skip whitespace and split string by comma
    DNSipList = [eachIP.strip() for eachIP in DNS_SERVER_IP_LIST.split(',')]
    DNSvrfList = [eachvrf.strip() for eachvrf in DNS_SERVER_VRF.split(',')]
   
    inputStatus = getComparisonStatusIP_VRFS(DNSipList, DNSvrfList)
    Wrapper.print("configureDNS: inputStatus [%s]" % str(inputStatus))
    
    # delete the existing policies.. we will recreate them in case they do not match the earlier ones
    for pti in ptis:
        PTIWrapper.markDeleteInstance(pti.getPolicyId())
    
    if(inputStatus == 1):
        eachIP = ""
        eachVrf = DNSvrfList[0]
        for ip in DNSipList:
            eachIP  += ip +' '
            # switch supports 6 DNS IP address to be configured at once
        confDNS(deviceSn,eachIP,eachVrf,CONFIG_PRIORITY_DNS_VRF)
    else:    
        # Create a dictionary to account for ips under same vrfs
        DNS_IPdict = {}
        for ip, vrf in zip(DNSipList, DNSvrfList):
            Wrapper.print(str(ip) + " " + str(vrf))
            if vrf in DNS_IPdict:
                dnsList = DNS_IPdict.get(vrf)
                dnsList.append(ip)
            else:
                dnsList = []
                dnsList.append(ip)
                DNS_IPdict[vrf] = dnsList
                Wrapper.print(str(DNS_IPdict))
        
        for vrf,ipList in DNS_IPdict.items():
            eachIP = ""
            eachVrf = vrf
            for ip in ipList:
                eachIP  += ip +' '
                # switch supports 6 DNS IP address to be configured at once
            confDNS(deviceSn,eachIP,eachVrf,CONFIG_PRIORITY_DNS_VRF)
            
    return respObj   
          
def confDNS(deviceSn,eachIP, eachVrf,CONFIG_PRIORITY_DNS_VRF):
    Wrapper.print("confDNS")
    Wrapper.print("IP: " +eachIP + " " + " vrf: " + eachVrf)
    eachIP = eachIP.strip(' ')
    if eachVrf == "default":
        Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                          ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP,
                                          "dnsList",
                                          {"NAME_SERVER_ADDRESSLIST":eachIP}))
    else:
        Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                          CONFIG_PRIORITY_DNS_VRF,
                                          "dns-vrfList",
                                          {"NAME_SERVER_VRF":eachVrf, "NAME_SERVER_ADDRESSLIST":eachIP}))

def configureNTP(respObj,deviceSn,NTP_SERVER_IP_LIST, NTP_SERVER_VRF):
    Wrapper.print("configureNTP: Switch [%s] NTP_SERVER_IP_LIST [%s]" % (deviceSn, NTP_SERVER_IP_LIST))
    
    if NTP_SERVER_IP_LIST == '' :
        cleanUpPti(deviceSn, "ntp_server", "UNDERLAY")
        return respObj
    
    NTPipList   =   []
    NTPvrfList  =   [] 
    
    # Skip whitespace and split string by comma
    NTPipList = [eachIP.strip() for eachIP in NTP_SERVER_IP_LIST.split(',')]
    NTPvrfList = [eachvrf.strip() for eachvrf in NTP_SERVER_VRF.split(',')]

    inputStatus = getComparisonStatusIP_VRFS(NTPipList, NTPvrfList)
    Wrapper.print("configureNTP: inputStatus [%s]" % str(inputStatus))
    
    # Search all the existing policies which needs to be deleted
    srchOpt = CtrlPolicySearch()
    srchOpt.setSerialNumber(deviceSn)
    srchOpt.setTemplateName("ntp_server")
    ptis = Util.exe(PTIWrapper.getPTIs(srchOpt))
    for pti in ptis:
        PTIWrapper.markDeleteInstance(pti.getPolicyId())
        
    if(inputStatus == 1):
        for ip in NTPipList:
            eachIP  = ip
            eachVrf = NTPvrfList[0]
            confNTP(deviceSn,eachIP,eachVrf)
    else:
        for ip, vrf in zip(NTPipList, NTPvrfList):
            eachIP  = ip
            eachVrf = vrf
            confNTP(deviceSn,eachIP,eachVrf)
    return respObj

def confNTP(deviceSn,eachIP, eachVrf):
