    srchOpt.setTemplateName("aaa_tacacs_use_vrf")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))
    srchOpt.setTemplateName("aaa_tacacs_src_interface")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))
    srchOpt.setTemplateName("aaa_radius_src_interface")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))
    srchOpt.setTemplateName("aaa_radius_deadtime")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))

    for pti in ptis:
        PTIWrapper.markDeleteInstance(pti.getPolicyId())

def configureAAA(dictObj):

    try:
        respObj         = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()
        deviceSn        = dictObj["DEVICE_SN"]
        AAA_SERVER_CONF = dictObj["AAA_SERVER_CONF"]
        aaa_conf        = AAA_SERVER_CONF.strip()
        AAA_CONF_ENC = ((AAA_SERVER_CONF.encode('ascii', 'ignore')).decode("utf-8"))
        Wrapper.print("configureAAA: Switch [%s] AAA_SERVER_CONF [%s]" % (deviceSn, AAA_CONF_ENC))
        
        if not aaa_conf:
            cleanUpAAAPtis(deviceSn, "switch_freeform", "UNDERLAY_AAA")
            return respObj
        
        # Search all the existing policies which needs to be deleted
        srchOpt = CtrlPolicySearch()
        srchOpt.setSerialNumber(deviceSn)
        srchOpt.setTemplateName("switch_freeform")
        
        ptis = Util.exe(PTIWrapper.getPTIs(srchOpt))
        aaaPolicyId = ""
        
        for pti in ptis:
            if pti.getDescription() == AAA_CONF_DESCRIPTION:
                # existing freeform that was created from the fabric settings
                aaaPolicyId = pti.getPolicyId()
                Wrapper.print("configureAAA: Found AAA freeform [%s]" % aaaPolicyId)
            elif pti.getDescription() == BROWNFIELD_AAA_CONF_DESCRIPTION:
                # freeform created during brownfield import
                Wrapper.print("configureAAA: Found Brownfield AAA freeform [%s]" % aaaPolicyId)
                PTIWrapper.deleteInstance(pti.getPolicyId())
        
        if aaaPolicyId:
            Util.exe(PTIWrapper.updateInstance(aaaPolicyId, {"CONF": aaa_conf}))
        else:
            # cleanup old AAA individual policies
            deleteExistingPoliciesAAA(deviceSn)
        
            # create the new AAA freeform policy
            Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY_AAA",
                    ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP,
                    "switch_freeform", {"CONF": aaa_conf}, AAA_CONF_DESCRIPTION))
        return respObj    
        
    except respObjError as e:
        return e.value

