            respObj.addErrorReport(deviceSn + ":" + funcName, errorMsg)
            respObj.setFailureRetCode()
            return respObj

        respObj.setSuccessRetCode()
        return respObj
    except respObjError as e:
        return e.value

def disableDCIMACsecAllowedCheck(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        ENABLE_DCI_MACSEC = dictObj["ENABLE_DCI_MACSEC"]
        ENABLE_DCI_MACSEC_PREV = dictObj["ENABLE_DCI_MACSEC_PREV"]
        ENABLE_QKD = dictObj["ENABLE_QKD"]
        FABRIC_NAME = dictObj["FABRIC_NAME"]

        Wrapper.print("%s: FAB [%s]: ENABLE_DCI_MACSEC [%s] ENABLE_QKD [%s] ENABLE_DCI_MACSEC_PREV [%s]" %
                      (funcName, FABRIC_NAME, ENABLE_DCI_MACSEC, ENABLE_QKD, ENABLE_DCI_MACSEC_PREV))

        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        if ENABLE_DCI_MACSEC == "false" and ENABLE_DCI_MACSEC_PREV == "false":
            return respObj

        if ENABLE_DCI_MACSEC == "true" and ENABLE_QKD == "true":
            return respObj

        topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(FABRIC_NAME)))
        devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
        devices = filter(None, devices)
        if len(devices) == 0:
            return respObj

        foundFailure = False
        srchOpt = CtrlPolicySearch()
        srchOpt.setTemplateName("dci_macsec_qkd_config")
        for deviceSn in devices:
            switchRole = topologyDataObj.getSwitchRole(deviceSn)
            if switchRole == "spine" or switchRole == "super spine" or switchRole == "tor":
                continue

            srchOpt.setSerialNumber(deviceSn)
            dciMACsecPtiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
            for pti in dciMACsecPtiList:
                if pti.isDeleted():
                    continue
                nvPairs = pti.getNvPairs()
                if ENABLE_DCI_MACSEC == "false":
                    if nvPairs["USE_LINK_MACSEC"] == "false":
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                            "Cannot disable DCI MACsec as MACsec is configured on some DCI links using fabric settings", deviceSn)
                        foundFailure = True
                elif ENABLE_QKD == "false":
                    if nvPairs["USE_LINK_MACSEC"] == "false" and nvPairs["ENABLE_QKD"] == "true":
                        respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                            "Cannot disable DCI MACsec with QKD as QKD is configured on some DCI links using fabric settings", deviceSn)
                        foundFailure = True

        if foundFailure:
            respObj.setFailureRetCode()
        return respObj
    except respObjError as e:
        return e.value

