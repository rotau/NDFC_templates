# Validation for 1:1 or 1 : many mapping of IP addreses , vrfs 
def getComparisonStatusIP_VRFS(iPList, vrfList):
     # Null or empty
    if((iPList == '' and vrfList == '') or (len(vrfList)==0 and len(iPList)==0)):
        return 0
    if(iPList == "" or vrfList == "" or len(vrfList)==0 or len(iPList)==0):
        return -1;
    # valid conditions
    if (len(vrfList) == 1):
        return 1;
    if (len(vrfList) == len(iPList)):
        return len(vrfList);
    # All other invalid
    return -1;
    
# returns the list of vrf strings entries and validate the input
def validateSyslogVrf(vrfListString, respObj):
    strList = [val.strip() for val in vrfListString.split(',')]
    for val in strList:
        # the vrf must be < 32 chars
        if (len(val) > 32):
            respObj.setFailureRetCode()
            respObj.addErrorReport("INVALID_SYSLOG_VRF", "Invalid Syslog VRF [%s]. Please ensure these are < 32 characters in length." % val)
            return None
    return strList

# returns the list of severity string entries and validate the input
def validateSyslogSeverity(sevListString, respObj):
    strList = [eachSev.strip() for eachSev in sevListString.split(',')]
    for val in strList:
        # the severity must an integer in the range 0-7
        isInvalid = True
        try:
            sevInt = int(val)
            if sevInt >= 0 and sevInt <= 7:
                isInvalid = False
        except:
            pass
        if isInvalid:
            respObj.setFailureRetCode()
            respObj.addErrorReport("INVALID_SYSLOG_SEVERITY", "Invalid Syslog Severity [%s]. Please ensure these are integers in the range 0-7." % val)
            return None
    return strList

# Validation for 1:1 or 1 : many mapping of IP addreses , Severity 
def getComparisonStatusIP_SEV(iPList, sevList):
     # Null or empty
    if((iPList == '' and sevList == '') or (len(sevList)==0 and len(iPList)==0)):
        return 0
    if(iPList == '' or sevList == '' or len(sevList)==0 or len(iPList)==0):
        return -1;
    # valid conditions
    if (len(sevList) == 1):
        return 1;
    if (len(sevList) == len(iPList)):
        return len(sevList);
    # All other invalid
    return -1;

