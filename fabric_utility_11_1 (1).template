        pti_found = True
        break
    return pti_found

def validateInitFabricSettings(dictObj):
    funcName = sys._getframe(0).f_code.co_name

    try:
        FABRIC_NAME = dictObj.get("FABRIC_NAME", "")
        Wrapper.print("========== FAB [%s]: Start: %s" % (FABRIC_NAME, funcName))
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()
        
        validationParams = dictObj.get("FABRIC_VALIDATION_PARAMS", {})
        Wrapper.print("%s: validationParams: %s" % (funcName, validationParams))
        
        validateManagebilitySettings = validationParams.get("validateManagebilitySettings", False)
        validateNetflowSettings = validationParams.get("validateNetflowSettings", False)
        validateLanDeviceConnectivityMode = validationParams.get("validateLanDeviceConnectivityMode", False)
        validatePvlanSettings = validationParams.get("validatePvlanSettings", False)
        validateNxCloudSettings = validationParams.get("validateNxCloudSettings", False)
        validateL3vniMode = validationParams.get("validateL3vniMode", False)
        validateBgpAsn = validationParams.get("validateBgpAsn", False)

        if validateManagebilitySettings:
            Util.exe(validateManageabilityTabSettings(dictObj))
        if validateNetflowSettings:
            Util.exe(validateNetflowTabSettings(dictObj))
        if validateLanDeviceConnectivityMode:
            Util.exe(checkLanDeviceConnectivityMode(dictObj))
        if validatePvlanSettings:
            Util.exe(validatePvlanFabSettings(dictObj))
        if validateNxCloudSettings:
            Util.exe(checkNxCloudSettings(dictObj))
        if validateL3vniMode:
            Util.exe(checkL3VniNoVlanSettings(dictObj))
        if validateBgpAsn:
            Util.exe(validateBgpAsnFabSettings(dictObj))

    except Exception as e:
        if isinstance(e, respObjError):
            Util.processRespObj(respObj, e.value)
        else:
            Util.handleException("Unexpected error validating fabric settings", e, respObj)
    finally:
        Wrapper.print("========== FAB [%s]: Finish: %s: Success = [%r]" %
                (FABRIC_NAME, funcName, respObj.isRetCodeSuccess()))
        return respObj

def checkLanDeviceConnectivityMode(dictionaryObj):
    funcName = sys._getframe(0).f_code.co_name
    respObj = WrappersResp.getRespObj()
    respObj.setSuccessRetCode()

    fabInbandMode = dictionaryObj.get("INBAND_MGMT", "false")
    # get the current LAN Device Connectivity server setting
    oobMode = Util.exe(FabricWrapper.getLanMgmtConnectivityMode())
    Wrapper.print("%s: fabInbandMode [%s] oobMode [%s]" % (funcName, fabInbandMode, oobMode))
    isError = False
    if fabInbandMode == "true":
        if oobMode.lower() == "management":
            isError = True

    if isError:
        errMsg = ("The 'LAN Device Management Connectivity' server setting is [%s] and is incompatible with the Inband Mode "
            "fabric setting. Please review documentation and set the mode or server setting appropriately." % (oobMode))
        respObj.addErrorReport("fabricInit:NDFC LAN Device Management", errMsg)
        respObj.setFailureRetCode()

    return respObj

def validateNetflowTabSettings(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        Wrapper.print("======== %s ==========" % funcName)
        FABRIC_NAME             = dictObj["FABRIC_NAME"]
        fabricSettings          = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        ENABLE_NETFLOW          = fabricSettings.get("ENABLE_NETFLOW", "false")
        ENABLE_NETFLOW_PREV     = fabricSettings.get("ENABLE_NETFLOW_PREV", "false")
        NETFLOW_EXPORTER_LIST   = fabricSettings.get("NETFLOW_EXPORTER_LIST", "")
        NETFLOW_RECORD_LIST     = fabricSettings.get("NETFLOW_RECORD_LIST", "")
        NETFLOW_MONITOR_LIST    = fabricSettings.get("NETFLOW_MONITOR_LIST", "")
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        Wrapper.print("%s: ENABLE_NETFLOW [%s], ENABLE_NETFLOW_PREV [%s]" % (funcName, ENABLE_NETFLOW, ENABLE_NETFLOW_PREV))
        if ENABLE_NETFLOW == "true":

            records = []
            exporters = []
            missing_records = []
            missing_exporters = []

            if NETFLOW_EXPORTER_LIST:
                exporter_list = ast.literal_eval(NETFLOW_EXPORTER_LIST)
                for exporter in exporter_list["NETFLOW_EXPORTER_LIST"]:
                    exporters.append(exporter["EXPORTER_NAME"])

            if NETFLOW_RECORD_LIST:
                record_list = ast.literal_eval(NETFLOW_RECORD_LIST)
                missingTemplates = []
                for record in record_list["NETFLOW_RECORD_LIST"]:
                    records.append(record["RECORD_NAME"])
    
                    # check whether record_template exist or not
                    if record["RECORD_TEMPLATE"] not in missingTemplates:
                        recordTemplatePresent = Util.exe(PTIWrapper.isTemplatePresent(record["RECORD_TEMPLATE"]))
                        if not recordTemplatePresent:
                            missingTemplates.append(record["RECORD_TEMPLATE"])
    
                if len(missingTemplates) != 0:
                    errMsg = ("Only existing templates can be used as Netflow Record Template. "
                              "Missing template%s %s." % ("s" if len(missingTemplates)>1 else "", str(missingTemplates)[1:-1]))
                    Wrapper.print("%s: %s" % (funcName, errMsg)) 
                    respObj.addErrorReport("validateNetflowTabSettings", errMsg)
                    respObj.setFailureRetCode()
                    return respObj

            if NETFLOW_MONITOR_LIST:
                monitor_list = ast.literal_eval(NETFLOW_MONITOR_LIST)
                for monitor in monitor_list["NETFLOW_MONITOR_LIST"]:
                    if (monitor["RECORD_NAME"] not in records) and (monitor["RECORD_NAME"] not in missing_records):
                        missing_records.append(monitor["RECORD_NAME"])
                    if (monitor["EXPORTER1"] not in exporters) and (monitor["EXPORTER1"] not in missing_exporters):
                        missing_exporters.append(monitor["EXPORTER1"])
                    if ("EXPORTER2" in monitor) and (monitor["EXPORTER2"] != "") and \
                        (monitor["EXPORTER2"] not in exporters) and (monitor["EXPORTER2"] not in missing_exporters):
                        missing_exporters.append(monitor["EXPORTER2"])

            if len(missing_records) != 0 or len(missing_exporters) != 0:
                errMsg = ""
                if len(missing_records) != 0:
                    if len(missing_records) == 1:
                        be = "is"
                    else:
                        be = "are"
                    errMsg = "%s referred in 'Netflow Monitor' %s not defined in 'Netflow Record'. Please define them first. " % (missing_records, be)
                if len(missing_exporters) != 0:
                    if len(missing_exporters) == 1:
                        be = "is"
                    else:
                        be = "are"
                    errMsg += "%s referred in 'Netflow Monitor' %s not defined in 'Netflow Exporter'. Please define them first. " % (missing_exporters, be)

                Wrapper.print(errMsg)
                respObj.addErrorReport("validateNetflowTabSettings", errMsg)
                respObj.setFailureRetCode()
        else:
            # netflow not enabled
            if ENABLE_NETFLOW_PREV == "false":
                return respObj

            # check any reference to netflow in vrf/network and interface/vlan level
            topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(FABRIC_NAME)))
            devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
            devices = filter(None, devices)
            netflow_pti_found = False

            for deviceSn in devices:
                netflow_pti_found = isIntfTmpltConfigPresent(deviceSn, "interface_ipv4_netflow")
                if netflow_pti_found:
                    break

                netflow_pti_found = isIntfTmpltConfigPresent(deviceSn, "interface_l2_netflow")
                if netflow_pti_found:
                    break

                netflow_pti_found = isDeviceTmpltPresent(deviceSn, "vlan_netflow")
                if netflow_pti_found:
                    break

                netflow_pti_found = isDeviceTmpltPresent(deviceSn, "vlan_netflow_sampler")
                if netflow_pti_found:
                    break

            if netflow_pti_found:
                errMsg = "Netflow is enabled at some interfaces, VRFs and/or Networks. "\
                         "Please disable netflow on interface, VRFs and Networks before disable netflow at the fabric setting. "
                Wrapper.print(errMsg)
                respObj.addErrorReport("validateNetflowTabSettings", errMsg)
                respObj.setFailureRetCode()

        if ENABLE_NETFLOW_PREV != ENABLE_NETFLOW:
            Wrapper.print("update ENABLE_NETFLOW_PREV to %s" % ENABLE_NETFLOW)
            Util.exe(FabricWrapper.update(FABRIC_NAME, "ENABLE_NETFLOW_PREV", ENABLE_NETFLOW))

        Wrapper.print("====== end of %s =======" % funcName)
        return respObj

    except respObjError as e:
        return e.value

def isModelNetflowSupported(model):
    if model and model.startswith("N7"):
        return True
    else:
        return model and model.startswith("N9K") and ("-EX" in model or "-FX" in model or "-GX" in model)

def isNetflowSupported(topologyDataObj, deviceSn):
    funcName = sys._getframe(0).f_code.co_name
    devModel = topologyDataObj.getSwitchModel(deviceSn)
    devModules = topologyDataObj.getSwitchModules(deviceSn)

    hw_supported = isEX = l2NetflowSupported = False

    if devModules:
        for module in devModules:
            model = module.get("ModelName")
            if model is None:
                # the model name is not present.. skip
                continue
            if isModelNetflowSupported(model):
                hw_supported = True
                if "-EX" in model:
                    isEX = True
    else:
        if isModelNetflowSupported(devModel):
            hw_supported = True
            if "-EX" in devModel:
                isEX = True

    if hw_supported:
        if isEX:
            nxosImageDetail = Util.exe(ImageManagementWrapper.getNXOSSysDescription(deviceSn))

            try:
                imgVersion = nxosImageDetail.split("Version ")[1].split(",")[0] if nxosImageDetail.split("Version ")[1] else ""
            except:
                imgVersion = ""

            if not imgVersion:
                imgVersion = Util.exe(ImageManagementWrapper.getNXOSVersion(deviceSn))

            try:
                imgMajorVer = imgVersion.split(".")[0]
                if int(imgMajorVer)  >= 9:
                    l2NetflowSupported = True
            except:
                Wrapper.print("%s: %s invalid image version %s" % (funcName, deviceSn, imgVersion))
        else:
            l2NetflowSupported = True

    Wrapper.print("%s: %s model %s, netflow_supported %s,l2NetflowSupported %s"
        % (funcName, deviceSn, devModel, hw_supported, l2NetflowSupported))

    return hw_supported, l2NetflowSupported, isEX

def allowNetflowConfig(dictObj):
    try:
        funcName            = sys._getframe(0).f_code.co_name
        FABRIC_NAME         = dictObj["FABRIC_NAME"]
        deviceSn            = dictObj["DEVICE_SN"]
        respObj             = WrappersResp.getRespObj()
        errorMsg            = ""
        allowNetflow        = True
        l2NetflowSupported  = False
        isEX                = False
        topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(FABRIC_NAME)))

        if "SOURCE" not in dictObj:
            # SOURCE of topdown does not need to check fabric setting or role
            fabricSettings = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
            if "ENABLE_NETFLOW" not in fabricSettings or fabricSettings["ENABLE_NETFLOW"] != "true":
                allowNetflow = False
                errorMsg = "Netflow can not be enabled while it is not enabled on fabric."
            else:
                fabricType = Util.exe(Helper.getFabricType(FABRIC_NAME))
                if fabricType == "Switch_Fabric":
                    switchRole = topologyDataObj.getSwitchRole(deviceSn)
                    if switchRole == "spine" or switchRole == "super spine":
                        allowNetflow = False
                        errorMsg = "NDFC does not support netflow on Spine or Super Spine in VXLAN fabric."
                elif fabricType != "External":
                    allowNetflow = False
                    errorMsg = "Netflow is not supported in fabric of type %s" % fabricType

        if allowNetflow:
            if isDeviceTmpltPresent(deviceSn, "no_netflow"):
                allowNetflow = False
                if "SOURCE" in dictObj:
                    errorMsg = "Netflow configuration is not generated with the presence of policy 'no_netflow'."
                else:
                    errorMsg = "Netflow cannot be enabled with the presence of policy 'no_netflow'."

        if allowNetflow:
            netflowSupported, l2NetflowSupported, isEX = isNetflowSupported(topologyDataObj, deviceSn)
            if not netflowSupported:
                allowNetflow = False
                errorMsg = "Netflow is not supported on %s. Netflow is only supported on N9K EX, FX, GX models and N7K." % topologyDataObj.getSwitchModel(deviceSn)
            elif "IS_LAYER2" in dictObj and dictObj["IS_LAYER2"] == "true" and not l2NetflowSupported:
                allowNetflow = False
                errorMsg = "Platform does not support L2 netflow. Please disable Netflow on this interface."
            elif "NETFLOW_SAMPLER" in dictObj and dictObj["NETFLOW_SAMPLER"]:
                devModel = Util.exe(InventoryWrapper.getSwitchModel(deviceSn))
                if not devModel.startswith("N7"):
                    allowNetflow = False
                    errorMsg = "Netflow sampler is not supported on %s" % devModel

        Wrapper.print("%s - [%s]: allowNetflow [%s], errorMsg [%s]" % (funcName, deviceSn, allowNetflow, errorMsg))

        if not allowNetflow:
            respObj.setValue({"ERROR_MSG": errorMsg})
            respObj.addErrorReport(deviceSn + ":" + funcName, errorMsg)
            respObj.setFailureRetCode()
            return respObj

        returnDict = {"l2_supported": l2NetflowSupported, "isEX": isEX}
        respObj.setValue(returnDict)
        respObj.setSuccessRetCode()
        return respObj
    except respObjError as e:
        return e.value

# caller provides DEVICES, FABRIC_NAME, topologyDataObj
def netflowConfigGen(dictObj):
    try:
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()
        devices = dictObj["DEVICES"]
        FABRIC_NAME = dictObj["FABRIC_NAME"]
        fabricSettings = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        dictObj.update({"ENABLE_NETFLOW": fabricSettings.get("ENABLE_NETFLOW", "false")})
        dictObj.update({"NETFLOW_EXPORTER_LIST": fabricSettings.get("NETFLOW_EXPORTER_LIST", "")})
        dictObj.update({"NETFLOW_RECORD_LIST":fabricSettings.get("NETFLOW_RECORD_LIST", "")})
        dictObj.update({"NETFLOW_MONITOR_LIST": fabricSettings.get("NETFLOW_MONITOR_LIST", "")})
        dictObj.update({"NETFLOW_SAMPLER_LIST": fabricSettings.get("NETFLOW_SAMPLER_LIST", "")})
        for deviceSn in devices:
            dictObj.update({"DEVICE_SN": deviceSn})
            newRespObj = netflowConfigGenDevice(dictObj)
            if not newRespObj.isRetCodeSuccess():
                Wrapper.print("netflowConfigGen: transfer warning message from %s" % (deviceSn))
                Util.processRespObj(respObj, newRespObj)

        return respObj
    except respObjError as e:
        return e.value

def netflowConfigGenDevice(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        deviceSn = dictObj["DEVICE_SN"]
        Wrapper.print("======== %s [%s] ==========" % (funcName, deviceSn))

        ENABLE_NETFLOW          = dictObj["ENABLE_NETFLOW"]
        NETFLOW_EXPORTER_LIST   = dictObj["NETFLOW_EXPORTER_LIST"]
        NETFLOW_RECORD_LIST     = dictObj["NETFLOW_RECORD_LIST"]
        NETFLOW_MONITOR_LIST    = dictObj["NETFLOW_MONITOR_LIST"]
        NETFLOW_SAMPLER_LIST    = dictObj["NETFLOW_SAMPLER_LIST"]
        skip_netflow            = False

        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        if ENABLE_NETFLOW == "true":
            respObj1 = allowNetflowConfig(dictObj)
            returnDict = respObj1.getValue()
            if respObj1.isRetCodeFailure():
                Wrapper.print("%s() allowNetflowConf error returnDict %s" % (funcName, returnDict))
                if "ERROR_MSG" in returnDict:
                    if not "Spine" in returnDict["ERROR_MSG"]:
                        respObj.addWarnReport(getFabErrEntity(funcName, deviceSn),
                                              returnDict["ERROR_MSG"],
                                              deviceSn)

                        respObj.setWarningRetCode()
                skip_netflow = True

        # remove existing netflow policies
        # The use of "NETFLOW" as source makes search easier, as the customized record template name is not known
        srchOpt = CtrlPolicySearch()
        srchOpt.setSerialNumber(deviceSn)
        srchOpt.setSource("NETFLOW")
        ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
        for pti in ptiList:
            PTIWrapper.markDeleteInstance(pti.getPolicyId())

        if ENABLE_NETFLOW == "true" and not skip_netflow:
            Util.exe(PTIWrapper.createOrUpdate(deviceSn, "SWITCH", "SWITCH", "NETFLOW",
                                               ConfigPriority.CONFIG_PRIO_TOP,
                                               "feature_netflow", {}))

            if NETFLOW_EXPORTER_LIST and len(NETFLOW_EXPORTER_LIST) > 0: 
                exporter_list = ast.literal_eval(NETFLOW_EXPORTER_LIST)
                for exporter in exporter_list["NETFLOW_EXPORTER_LIST"]:
                    if "VRF" in exporter:
                        vrf_name = exporter["VRF"]
                        vrf_name = vrf_name.lstrip(" ")
                    else:
                        vrf_name = ""
    
                    src_intf = Util.exe(Helper.getInterfaceName2(exporter["SRC_IF_NAME"]))
                    # In switch, loopback, mgmt, port-channel as exporter source are lower case, vlan is upper case
                    if src_intf.startswith("Loop"):
                        src_intf = "l" + src_intf[1:]
                    elif src_intf.startswith("Port"):
                        src_intf = "p" + src_intf[1:]
                    elif src_intf.startswith("M"):
                        src_intf = "m" + src_intf[1:]
                    elif src_intf.startswith("v"):
                        src_intf = "V" + src_intf[1:]
    
                    Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "NETFLOW",
                                               ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP_LVL1,
                                               "netflow_exporter",
                                               {"EXPORTER_NAME": exporter["EXPORTER_NAME"],
                                                "IP": exporter["IP"],
                                                "VRF": vrf_name,
                                                "SRC_IF_NAME": src_intf,
                                                "UDP_PORT": exporter["UDP_PORT"]}))

            if NETFLOW_RECORD_LIST and len(NETFLOW_RECORD_LIST) > 0:
                record_list = ast.literal_eval(NETFLOW_RECORD_LIST)
                l2_record = []
                for record in record_list["NETFLOW_RECORD_LIST"]:
                    if not returnDict["l2_supported"] and record["LAYER2_RECORD"] == "true":
                        l2_record.append(record["RECORD_NAME"])
                        warningMsg = "Netflow record and monitor for layer 2 will not be applied. EX Switch runnig pre 9.x NXOS image does not support Layer 2 netflow."
                        Wrapper.print("%s: %s: %s" % (funcName, deviceSn, warningMsg))
                        respObj.addWarnReport(getFabErrEntity(funcName, deviceSn), warningMsg, deviceSn)
                        respObj.setWarningRetCode()
                        continue
    
                    Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "NETFLOW",
                                               ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP_LVL1,
                                               record["RECORD_TEMPLATE"],
                                               {"RECORD_NAME": record["RECORD_NAME"]}))

            if NETFLOW_MONITOR_LIST and len(NETFLOW_MONITOR_LIST) > 0:
                monitor_list = ast.literal_eval(NETFLOW_MONITOR_LIST)
                for monitor in monitor_list["NETFLOW_MONITOR_LIST"]:
                    if not returnDict["l2_supported"] and monitor["RECORD_NAME"] in l2_record:
                        continue
    
                    if "EXPORTER2" in monitor:
                        exporter2 = monitor["EXPORTER2"]
                        exporter2 = exporter2.lstrip(" ")
                    else:
                        exporter2 = ""
                    Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "NETFLOW",
                                               ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP_LVL2,
                                               "netflow_monitor",
                                               {"MONITOR_NAME": monitor["MONITOR_NAME"],
                                                "RECORD_NAME": monitor["RECORD_NAME"],
                                                "EXPORTER1": monitor["EXPORTER1"],
                                                "EXPORTER2": exporter2}))

            if NETFLOW_SAMPLER_LIST and len(NETFLOW_SAMPLER_LIST) > 0:
                sampler_list = ast.literal_eval(NETFLOW_SAMPLER_LIST)
                topologyDataObj = dictObj["topologyDataObj"]
                devModel = topologyDataObj.getSwitchModel(deviceSn)
                if devModel.startswith("N7"):
                    for sampler in sampler_list["NETFLOW_SAMPLER_LIST"]:
                        Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "NETFLOW",
                                           ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP_LVL2,
                                           "netflow_sampler",
                                           {"SAMPLER_NAME": sampler["SAMPLER_NAME"],
                                            "NUM_SAMPLES": sampler["NUM_SAMPLES"],
                                            "SAMPLING_RATE": sampler["SAMPLING_RATE"]}))

    except Exception as e:
        errMsg = "Unexpected error creating netflow policies for switch [%s]." % deviceSn
        if isinstance(e, respObjError):
            respObj.addErrorReport(funcName, errMsg)
            respObj.setFailureRetCode()
            Util.processRespObj(respObj, e.value)
        else:
            Util.handleException(errMsg, e, respObj)
    finally:
        Wrapper.print("======== end of %s [%s] ========== Success = [%r]" % (funcName, deviceSn, respObj.isRetCodeSuccess()))
        return respObj

def validatePvlanFabSettings(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        Wrapper.print("======== %s ==========" % funcName)
        FABRIC_NAME           = dictObj["FABRIC_NAME"]
        fabricSettings        = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        ENABLE_PVLAN          = fabricSettings.get("ENABLE_PVLAN", "false")
        ENABLE_PVLAN_PREV     = fabricSettings.get("ENABLE_PVLAN_PREV", "false")
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        Wrapper.print("%s: ENABLE_PVLAN [%s], ENABLE_PVLAN_PREV [%s]" % (funcName, ENABLE_PVLAN, ENABLE_PVLAN_PREV))
        if ENABLE_PVLAN_PREV == ENABLE_PVLAN:
            return respObj

        fabricType = Util.exe(Helper.getFabricType(FABRIC_NAME))
        if fabricType == "Switch_Fabric":
            try:
                getRespObj = FabricWrapper.getParentFabricName(FABRIC_NAME)
                if getRespObj.isRetCodeSuccess():
                    errMsg = "Cannot change 'Enable Private VLAN' in the child fabric."
                    Wrapper.print("%s: %s" % (funcName, errMsg))
                    respObj.addErrorReport(funcName, errMsg)
                    respObj.setFailureRetCode()
                    return respObj
            except:
                pass

        if ENABLE_PVLAN != "true":
            # PVLAN to be disabled. Check whether any pvlan policy or network
            if fabricType == "Switch_Fabric":
                if not isDisablePvlanAllowed(FABRIC_NAME, respObj, True):
                    return respObj
            elif fabricType == "MFD":
                # check PVLAN Networks
                respObj2 = TopDownOverlayWrapper.arePvlanOverlaysPresent(FABRIC_NAME)
                if respObj2.isRetCodeSuccess():
                    pvlan_network_present = respObj2.getValue()
                    if pvlan_network_present:
                        errMsg = "Can not disable Private VLAN (PVLAN) in the fabric setting while PVLAN Network is present. "
                        Wrapper.print("%s: %s" % (funcName, errMsg))
                        respObj.addErrorReport(funcName, errMsg)
                        respObj.setFailureRetCode()
                        return respObj

                mfdResp = MfdWrapper.getMfdFabricList(FABRIC_NAME)
                if not mfdResp.isRetCodeSuccess():
                    respObj.addErrorReport(funcName, "Failed to get Fabric List for %s "% (FABRIC_NAME))
                    respObj.setFailureRetCode()
                    return respObj

                fabricList = mfdResp.getFabricNameList()
                for fabricName in fabricList:
                    fabricType = Util.exe(Helper.getFabricType(fabricName))
                    if fabricType != "Switch_Fabric":
                        continue

                    mFabricSettings = Util.exe(FabricWrapper.get(fabricName)).getNvPairs()
                    if "ENABLE_PVLAN" in mFabricSettings and mFabricSettings["ENABLE_PVLAN"] == "true":
                        if not isDisablePvlanAllowed(fabricName, respObj, False):
                            return respObj
        else:
            # about to enable PVLAN. Block if there is any IOS XE fabric
            mfdResp = MfdWrapper.getMfdFabricList(FABRIC_NAME)
            if not mfdResp.isRetCodeSuccess():
                respObj.addErrorReport(funcName, "Failed to get Fabric List for %s "% (FABRIC_NAME))
                respObj.setFailureRetCode()
                return respObj

            fabricList = mfdResp.getFabricNameList()
            for fabricName in fabricList:
                FF = Util.exe(FabricWrapper.get(fabricName, "FF"))
                if FF == "Easy_Fabric_IOS_XE":
                    errMsg = "Private VLAN is not supported in Campus VXLAN EVPN fabric. Can not enable Private VLAN with the presence of Campus VXLAN EVPN fabric as child fabric. "
                    Wrapper.print("%s: %s" % (funcName, errMsg))
                    respObj.addErrorReport(funcName, errMsg)
                    respObj.setFailureRetCode()
                    return respObj

        Wrapper.print("====== end of %s: pass =======" % funcName)
        return respObj

    except respObjError as e:
        return e.value

# for BGP fabric only
def validateBgpAsnFabSettings(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        Wrapper.print("======== %s ==========" % funcName)
        FABRIC_NAME           = dictObj["FABRIC_NAME"]
        fabricSettings        = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        BGP_AS                = fabricSettings.get("BGP_AS", "")
        LEAF_BGP_AS           = fabricSettings.get("LEAF_BGP_AS", "")
        BORDER_BGP_AS         = fabricSettings.get("BORDER_BGP_AS", "")
        SUPER_SPINE_BGP_AS    = fabricSettings.get("SUPER_SPINE_BGP_AS", "")
        BGP_AS_MODE           = fabricSettings.get("BGP_AS_MODE", "")
        BGP_AS_MODE_PREV      = fabricSettings.get("BGP_AS_MODE_PREV", "")

        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        if BGP_AS_MODE != BGP_AS_MODE_PREV and BGP_AS_MODE == "Multi-AS":
            # Same-Tier-AS to Multi-AS not allowed if overlay present and leaf_bgp_asn not present
            topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(FABRIC_NAME)))
            devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
            devices = filter(None, devices)
            srchOpt = CtrlPolicySearch()
            errMsg = ""
            for deviceSn in devices:
                switchRole = topologyDataObj.getSwitchRole(deviceSn)
                if "spine" in switchRole:
                    continue

                if not CommonDAO.isOverlayAllowingRoleChange(deviceSn):
                    # Overlay present
                    srchOpt.setSerialNumber(deviceSn)
                    srchOpt.setTemplateName("leaf_bgp_asn")
                    ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                    if not ptiList:
                        hostName = Util.exe(InventoryWrapper.getHostName(deviceSn))
                        errorMsg = "BGP AS mode cannot be changed from Same-Tier-AS to Multi-AS with the presence of overlay config on %s %s which does not have BGP AS defined" % (switchRole,hostName)
                        Wrapper.print("%s: %s" % (funcName, errorMsg))
                        respObj.addErrorReport(funcName, errorMsg)
                        respObj.setFailureRetCode()
                        return respObj

                if switchRole == "border gateway":
                    srchOpt.setSerialNumber(deviceSn)
                    srchOpt.setTemplateName("ext_base_border_multisite")
                    ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                    if ptiList:
                        srchOpt.setTemplateName("leaf_bgp_asn")
                        ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                        if not ptiList:
                            hostName = Util.exe(InventoryWrapper.getHostName(deviceSn))
                            errorMsg = "BGP AS mode cannot be changed from Same-Tier-AS to Multi-AS with the presence of ext_base_border_multisite policy on %s %s which does not have BGP AS defined" % (switchRole,hostName)
                            Wrapper.print("%s: %s" % (funcName, errorMsg))
                            respObj.addErrorReport(funcName, errorMsg)
                            respObj.setFailureRetCode()
                            return respObj

        if BGP_AS_MODE != "Same-Tier-AS":
            return respObj

        if LEAF_BGP_AS:
            Util.exe(Helper.isValidAsn(LEAF_BGP_AS))
            if LEAF_BGP_AS == BGP_AS or LEAF_BGP_AS == SUPER_SPINE_BGP_AS:
                errorMsg = "Leaf BGP AS number cannot be the same as Spine BGP ASN or Super Spine BGP ASN"
                Wrapper.print("%s: %s" % (funcName, errorMsg))
                respObj.addErrorReport(funcName, errorMsg)
                respObj.setFailureRetCode()
                return respObj

        if BORDER_BGP_AS:
            Util.exe(Helper.isValidAsn(BORDER_BGP_AS))
            if BORDER_BGP_AS == BGP_AS or BORDER_BGP_AS == SUPER_SPINE_BGP_AS:
                errorMsg = "Border BGP AS number cannot be the same as Spine BGP ASN or Super Spine BGP ASN"
                Wrapper.print("%s: %s" % (funcName, errorMsg))
                respObj.addErrorReport(funcName, errorMsg)
                respObj.setFailureRetCode()
                return respObj

        topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(FABRIC_NAME)))
        devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
        devices = filter(None, devices)
        srchOpt = CtrlPolicySearch()

        errMsg = ""
        for deviceSn in devices:
            switchRole = topologyDataObj.getSwitchRole(deviceSn)
            if "spine" in switchRole:
                continue

            policyLeafBgpAsn = ""
            srchOpt.setSerialNumber(deviceSn)
            srchOpt.setTemplateName("bgp_asn")
            ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
            for pti in ptiList:
                if pti.isDeleted() == False:
                    policyLeafBgpAsn = pti.getNvPairs()["BGP_AS"]

            if switchRole == "leaf":
                fabricAsn = LEAF_BGP_AS
                fabricAsnStr = "Leaf BGP ASN"
            else:
                fabricAsn = BORDER_BGP_AS
                fabricAsnStr = "Border BGP ASN"

            if fabricAsn:
                if policyLeafBgpAsn and fabricAsn != policyLeafBgpAsn:
                    hostName = Util.exe(InventoryWrapper.getHostName(deviceSn))
                    errMsg += ("%s in Fabric Settings cannot be different from BGP ASN in switch leaf_bgp_asn policy. "
                               "Current %s in Fabric Settings is %s and switch %s has leaf_bgp_asn policy with BGP ASN %s. " %
                               (fabricAsnStr, fabricAsnStr, fabricAsn, hostName, policyLeafBgpAsn))

                if policyLeafBgpAsn == "":
                    srchOpt.setTemplateName("base_bgp")
                    ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                    for pti in ptiList:
                        if pti.isDeleted() == False and fabricAsn != pti.getNvPairs()["BGP_AS"]:
                            hostName = Util.exe(InventoryWrapper.getHostName(deviceSn))
                            errMsg += ("%s in Fabric Settings cannot be changed to %s as switch %s is already configured with BGP ASN %s. " \
                                       %(fabricAsnStr, fabricAsn, hostName, pti.getNvPairs()["BGP_AS"]))
            elif policyLeafBgpAsn == "":
                overlayConfigPresent = False
                if not CommonDAO.isOverlayAllowingRoleChange(deviceSn):
                    overlayConfigPresent = True
                else:
                    srchOpt.setTemplateName("ebgp_overlay_leaf_all_neighbor")
                    overlayPtiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                    if overlayPtiList:
                        overlayConfigPresent = True
                    elif switchRole == "border gateway":
                        srchOpt.setTemplateName("ext_base_border_multisite")
                        ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                        if ptiList:
                            overlayConfigPresent = True

                if overlayConfigPresent:
                    hostName = Util.exe(InventoryWrapper.getHostName(deviceSn))
                    errMsg += "%s in Fabric Settings cannot be removed with presence of overlay config, ebgp_overlay_leaf_all_neighbor or ext_base_border_multisite policy on %s. " % (fabricAsnStr, hostName)

        if errMsg:
            respObj.addErrorReport(funcName, errMsg)
            respObj.setFailureRetCode()

        Wrapper.print("====== end of %s: pass =======" % funcName)
        return respObj

    except respObjError as e:
        return e.value

def isDisablePvlanAllowed(fabric_name, respObj, checkOverlayPresent):
    funcName = sys._getframe(0).f_code.co_name
    topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(fabric_name)))
    devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
    devices = filter(None, devices)
    pvlan_pti_found = False

    for deviceSn in devices:
        if isPolicyPresent(deviceSn, "int_pvlan_host") or \
           isPolicyPresent(deviceSn, "int_port_channel_pvlan_host") or \
           isPolicyPresent(deviceSn, "int_vpc_pvlan_host") or \
           isPolicyPresent(deviceSn, "create_pvlan"):
            pvlan_pti_found = True
            break

    if pvlan_pti_found:
        errMsg = "Can not disable PVLAN at the fabric setting while PVLAN interface/vlan policy is present on certain device(s). "
        Wrapper.print("%s: %s" % (funcName, errMsg))
        respObj.addErrorReport(funcName, errMsg)
        respObj.setFailureRetCode()
        return False

    if not checkOverlayPresent:
        return True

    # check PVLAN Networks
    respObj2 = TopDownOverlayWrapper.arePvlanOverlaysPresent(fabric_name)
    if respObj2.isRetCodeSuccess():
        pvlan_network_present = respObj2.getValue()
        if pvlan_network_present:
            errMsg = "Can not disable Private VLAN (PVLAN) in the fabric setting while PVLAN Network is present. "
            Wrapper.print("%s: %s" % (funcName, errMsg))
            respObj.addErrorReport(funcName, errMsg)
            respObj.setFailureRetCode()
            return False

    return True

def allowPvlanIntfConfig(dictObj):
    try:
        funcName            = sys._getframe(0).f_code.co_name
        deviceSn            = dictObj["DEVICE_SN"]
        respObj             = WrappersResp.getRespObj()
        errorMsg            = ""

        FABRIC_NAME = Util.exe(InventoryWrapper.getFabricNameForSwitch(deviceSn))
        pvlan_allowed = Util.exe(FabricWrapper.get(FABRIC_NAME)).nvPairs.get("ENABLE_PVLAN", "true")
        if pvlan_allowed != "true":
