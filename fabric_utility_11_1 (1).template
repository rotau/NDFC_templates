                                           ConfigPriority.CONFIG_PRIO_UNDERLAY_TOP,
                                           "ntp_server",
                                           {"NTP_SERVER":eachIP, "NTP_SERVER_VRF":eachVrf}))
    
def configureSYSLOG(respObj,deviceSn,SYSLOG_SERVER_IP_LIST, SYSLOG_SEV, SYSLOG_SERVER_VRF):
    Wrapper.print("configureSYSLOG: Switch [%s] SYSLOG_SERVER_IP_LIST [%s]" % (deviceSn, SYSLOG_SERVER_IP_LIST))

    if SYSLOG_SERVER_IP_LIST == '':
        cleanUpPti(deviceSn, "syslog_server_vrf", "UNDERLAY")
        cleanUpPti(deviceSn, "syslog_server", "UNDERLAY")
        cleanUpPti(deviceSn, "syslog_server_sev", "UNDERLAY")
        cleanUpPti(deviceSn, "syslog_server_vrf_no_sev", "UNDERLAY")
        return respObj
     
    SYSipList   =   []
    SYSvrfList  =   []
    SYSsevList  =   []
    
    # Skip whitespace and split string by comma
    SYSipList  = [eachIP.strip() for eachIP in SYSLOG_SERVER_IP_LIST.split(',')]
    SYSvrfList = validateSyslogVrf(SYSLOG_SERVER_VRF, respObj)
    SYSsevList = validateSyslogSeverity(SYSLOG_SEV, respObj)
    if respObj.isRetCodeFailure():
        return respObj

    # Check for valid number of IP , vrfs and Severity
    inputStatusVrf = getComparisonStatusIP_VRFS(SYSipList, SYSvrfList)
    inputStatusSev = getComparisonStatusIP_SEV(SYSipList,SYSsevList)
    
    # Search all the existing policies which needs to be deleted
    srchOpt = CtrlPolicySearch()
    srchOpt.setSerialNumber(deviceSn)
    srchOpt.setTemplateName("syslog_server_vrf")
    ptis = Util.exe(PTIWrapper.getPTIs(srchOpt))
    srchOpt.setTemplateName("syslog_server")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))
    srchOpt.setTemplateName("syslog_server_sev")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))
    srchOpt.setTemplateName("syslog_server_vrf_no_sev")
    ptis += Util.exe(PTIWrapper.getPTIs(srchOpt))
    # delete the existing policies.. we will recreate them in case they do not match the earlier ones
    for pti in ptis:
        PTIWrapper.markDeleteInstance(pti.getPolicyId())
    
    # Single Vrf and Single Severity
    if(inputStatusVrf == 1 and inputStatusSev == 1 ):
        for ip in SYSipList:
            eachIP  = ip
            eachVrf = SYSvrfList[0]
            eachSev = SYSsevList[0]
            confSYSLOG(deviceSn,eachIP,eachVrf, eachSev)
        # Single Vrf
    elif inputStatusVrf == 1 :
        for ip,sev in zip(SYSipList,SYSsevList):
            eachIP  = ip
            eachVrf = SYSvrfList[0]
            eachSev = sev
            confSYSLOG(deviceSn,eachIP,eachVrf, eachSev)
        # Single Severity
    elif inputStatusSev == 1:
        for ip,vrf in zip(SYSipList,SYSvrfList):
            eachIP  = ip
            eachVrf = vrf
            eachSev = SYSsevList[0]
            confSYSLOG(deviceSn,eachIP,eachVrf, eachSev)
    else:
        for ip, vrf,sev in zip(SYSipList, SYSvrfList,SYSsevList):
            eachIP  = ip
            eachVrf = vrf
            eachSev = sev
            confSYSLOG(deviceSn,eachIP,eachVrf, eachSev)

    return respObj
            
def confSYSLOG(deviceSn,eachIP,eachVrf, eachSev):
    if eachSev != "5":
        if eachVrf.lower() != "default":
            Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                       1101, # need to be higher than topdown vrf priority
                                       "syslog_server_vrf",
                                       {"IP":eachIP, "SEVERITY":eachSev, "VRF":eachVrf}))
        else:
            Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                       1101, # need to be higher than topdown vrf priority
                                       "syslog_server_sev",
                                       {"IP":eachIP, "SEVERITY":eachSev}))
        return

    # syslog severity is 5
    # "show run" does not show severity 5 starting 10.2(4)/10.3(2) or if server vrf is default
    if eachVrf.lower() == "default":
        Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                   1101, # need to be higher than topdown vrf priority
                                   "syslog_server",
                                   {"IP":eachIP}))
        return

    sevInShowRun = True
    nxosVersion = Util.exe(ImageManagementWrapper.getNXOSVersion(deviceSn))
    if nxosVersion.startswith("10.2") and Util.isSupportedN9kImage(nxosVersion, "10.2(4)"):
        sevInShowRun = False
    elif Util.isSupportedN9kImage(nxosVersion, "10.3(2)"):
        sevInShowRun = False
    if sevInShowRun:
        Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                   1101, # need to be higher than topdown vrf priority
                                   "syslog_server_vrf",
                                   {"IP":eachIP, "SEVERITY":eachSev, "VRF":eachVrf}))
    else:
        Util.exe(PTIWrapper.create(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                   1101, # need to be higher than topdown vrf priority
                                   "syslog_server_vrf_no_sev",
                                   {"IP":eachIP, "VRF":eachVrf}))

