def checkSGTSettings(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        Wrapper.print("======== %s ==========" % funcName)
        FABRIC_NAME           = dictObj["FABRIC_NAME"]
        topologyDataObj       = dictObj.get("topologyDataObj")
        devices               = dictObj.get("devices")
        fabricSettings        = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        ENABLE_SGT            = fabricSettings.get("ENABLE_SGT", "false")
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        if ENABLE_SGT != "true":
            return respObj
        
        if not topologyDataObj:
            topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(FABRIC_NAME)))
        if not devices:
            devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
            devices = filter(None, devices)

        for deviceSn in devices:
            switchRole = topologyDataObj.getSwitchRole(deviceSn)
            if switchRole == "spine" or switchRole == "super spine" or switchRole == "tor":
                continue

            devModel = topologyDataObj.getSwitchModel(deviceSn)
            platformOK = False
            if devModel.startswith("N9K") and ("-GX" in devModel or "FX3" in devModel or "-FX" in devModel or "-FX2" in devModel or "-H" in devModel or "-C9408" in devModel):
                platformOK = True

            if not platformOK:
                respObj.addErrorReport(deviceSn + ":" + funcName,
                                       "Platform does not support Security Groups. "
                                       "Security Groups feature is only supported on fixed N9K GX/GX2/FX/FX2/FX3/H/C9408 platforms." , deviceSn)
                respObj.setFailureRetCode()
            else:
                supported_version = "10.5(2)"

                swVersionOk = Util.isSwVersionOk(deviceSn, supported_version)
                if not swVersionOk:
                    nxosImage = Util.exe(ImageManagementWrapper.getNXOSVersion(deviceSn))
                    respObj.addErrorReport(deviceSn + ":" + funcName,
                                        "Security Groups feature is supported from %s onwards, switch has %s" %
                                        (supported_version, nxosImage), deviceSn)
                    respObj.setFailureRetCode()

        return respObj
    except respObjError as e:
        return e.value

def isValidV4IpAddr(addr):
    try:
        socket.inet_aton(addr)
        return True
    except socket.error:
        return False

def isValidV6IpAddr(addr):
    try:
        socket.inet_pton(socket.AF_INET6, addr)
        return True
    except socket.error:
        return False

def isValidHostname(hostname):
    if len(hostname) > 233:
        return False
    if hostname.endswith("."): # A single trailing dot is legal
        hostname = hostname[:-1] # strip exactly one dot from the right, if present
    disallowed = re.compile("[^A-Z\d-]", re.IGNORECASE)
    return all( # Split by labels and verify individually
        (label and len(label) <= 233 # length is within proper range
         and not label.startswith("-") and not label.endswith("-") # no bordering hyphens
         and not disallowed.search(label)) # contains only legal characters
        for label in hostname.split("."))

def checkNxCloudSettings(dictObj):
    funcName = sys._getframe(0).f_code.co_name
    respObj = WrappersResp.getRespObj()
    respObj.setSuccessRetCode()

    isNxCloudFeatEnabled = Util.exe(FabricWrapper.isFeatureEnabled("nxcloud"))
    Wrapper.print("%s: isNxCloudFeatEnabled=%r FABRIC_INIT=%r" % (funcName, isNxCloudFeatEnabled, dictObj["FABRIC_INIT"]))
    if not isNxCloudFeatEnabled:
        return respObj

    FABRIC_NAME = dictObj["FABRIC_NAME"]
    fabricSettings = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
    Wrapper.print("%s: FABRIC_NAME=%s fabricSettings=%s" % (funcName, FABRIC_NAME, fabricSettings))
    ALLOW_NXC = fabricSettings.get("ALLOW_NXC", "false")
    ALLOW_NXC_PREV = fabricSettings.get("ALLOW_NXC_PREV", "false")

    if ALLOW_NXC != "true" and ALLOW_NXC_PREV == "true":
        if Util.exe(FabricWrapper.isNxCloudImportedFabric(FABRIC_NAME)):
            respObj.addErrorReport(funcName,
                "Nexus Cloud settings may not be disabled from fabric [%s] as it is imported into Nexus Cloud." % FABRIC_NAME)
            respObj.setFailureRetCode()
            return respObj

    if ALLOW_NXC != "true":
        return respObj
    
    OVERWRITE_GLOBAL_NXC = fabricSettings.get("OVERWRITE_GLOBAL_NXC", "false")
    if dictObj["FABRIC_INIT"] and OVERWRITE_GLOBAL_NXC != "true":
        return respObj
  
    if dictObj["FABRIC_INIT"]:
        NXC_DEST_VRF      = fabricSettings.get("NXC_DEST_VRF", "")
        NXC_SRC_INTF      = fabricSettings.get("NXC_SRC_INTF", "")
        NXC_PROXY_SERVER  = fabricSettings.get("NXC_PROXY_SERVER", "")
        NXC_PROXY_PORT    = fabricSettings.get("NXC_PROXY_PORT", "")
    else:
        NXC_DEST_VRF      = dictObj.get("NXC_DEST_VRF", "")
        NXC_SRC_INTF      = dictObj.get("NXC_SRC_INTF", "")
        NXC_PROXY_SERVER  = dictObj.get("NXC_PROXY_SERVER", "")
        NXC_PROXY_PORT    = dictObj.get("NXC_PROXY_PORT", "")
    Wrapper.print("%s: NXC_DEST_VRF %s NXC_SRC_INTF %s NXC_PROXY_SERVER %s NXC_PROXY_PORT %s" %
                  (funcName, NXC_DEST_VRF, NXC_SRC_INTF, NXC_PROXY_SERVER, NXC_PROXY_PORT))

    supportedInterfaceTypes = ["Loopback", "Port-Channel", "Vlan"]
 
    nxcDestVrf = ""
    if NXC_DEST_VRF == "":
        respObj.addErrorReport(funcName, "Intersight Destination VRF must be set for communication to Nexus Cloud, "
                               "please set the Destination VRF in %s" %
                               ("Global NxCloud Settings" if OVERWRITE_GLOBAL_NXC != "true" else "Fabric Settings"))
        respObj.setFailureRetCode()
    else:
        nxcDestVrf = "default" if NXC_DEST_VRF.strip().lower() == "default" else NXC_DEST_VRF.strip()
        if nxcDestVrf.lower() == "management":
            nxcDestVrf = "management"
        if nxcDestVrf != "management" and NXC_SRC_INTF == "":
            respObj.addErrorReport(funcName, "Intersight Source Interface must be set if Destination VRF is not management, "
                                   "please set the Source Interface in %s" %
                                   ("Global NxCloud Settings" if OVERWRITE_GLOBAL_NXC != "true" else "Fabric Settings"))
            respObj.setFailureRetCode()
        if nxcDestVrf == "management" and NXC_SRC_INTF != "":
            respObj.addErrorReport(funcName, "Intersight Source Interface [%s] should not be set if Destination VRF is management" %
                                   (NXC_SRC_INTF))
            respObj.setFailureRetCode()

    if NXC_SRC_INTF != "" and nxcDestVrf != "" and nxcDestVrf != "management":
        intfType = Util.getIntfFullType(NXC_SRC_INTF)
        if intfType not in supportedInterfaceTypes:
            respObj.addErrorReport(funcName, "Intersight Source Interface [%s] is not supported for communication to Nexus Cloud, "
                                   "supported interfaces: loopback, port-channel, vlan" % NXC_SRC_INTF)
            respObj.setFailureRetCode()
        elif intfType == "Port-Channel" and "." in NXC_SRC_INTF:
            respObj.addErrorReport(funcName, "Intersight Source Interface [%s] is not supported for communication to Nexus Cloud, "
                                   "supported interfaces: loopback, port-channel (no sub-interface), vlan" % NXC_SRC_INTF)

    if NXC_PROXY_SERVER != "":
        proxyServer = NXC_PROXY_SERVER.strip()
        if Util.isIpv6Addr(proxyServer):
            if not isValidV6IpAddr(proxyServer):
                respObj.addErrorReport(funcName, "Intersight Proxy Server [%s] is not a valid IPv6 server address" % proxyServer)
                respObj.setFailureRetCode()
        else:
            digitFound = False
            dotFound = False
            otherFound = False
            for char in proxyServer:
                if char.isdigit():
                    digitFound = True
                elif char == ".":
                    dotFound = True
                else:
                    otherFound = True
            if digitFound and dotFound and not otherFound:
                if not isValidV4IpAddr(proxyServer):
                    respObj.addErrorReport(funcName, "Intersight Proxy Server [%s] is not a valid IPv4 server address" % proxyServer)
                    respObj.setFailureRetCode()
            elif not isValidHostname(proxyServer):
                respObj.addErrorReport(funcName, "Intersight Proxy Server [%s] is not a valid DNS name. "
                                       "DNS name (FQDN) must start and end with an alphanumeric character, "
                                       "or end with a single trailing dot; "
                                       "only special characters allowed are '.' or '-'" % proxyServer)
                respObj.setFailureRetCode()

    if NXC_PROXY_PORT != "":
        proxyPortInt = int(NXC_PROXY_PORT)
        if proxyPortInt < 1 or proxyPortInt > 65535:
            respObj.addErrorReport(funcName, "Intersight Proxy Port [%s] is not a valid port number, valid range <1-65535>" % NXC_PROXY_PORT)
            respObj.setFailureRetCode()

    return respObj

# caller provides FABRIC_NAME, DEVICES, topologyDataObj
def nexusCloudConfigGen(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        FABRIC_NAME = dictObj["FABRIC_NAME"]
        devices = dictObj["DEVICES"]
        topologyDataObj = dictObj["topologyDataObj"]

        fabricSettings = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        ALLOW_NXC = fabricSettings.get("ALLOW_NXC", "false")

        isNxCloudFeatEnabled = Util.exe(FabricWrapper.isFeatureEnabled("nxcloud"))
        if not isNxCloudFeatEnabled or ALLOW_NXC != "true":
            for deviceSn in devices:
                ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "nexus_cloud"))
                for pti in ptiList:
                    Util.exe(PTIWrapper.deleteInstance(pti.getPolicyId()))
                ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "nxcloud_intersight_config", "nexus_cloud_internal"))
                if ptiList:
                    Util.exe(PTIWrapper.delete(deviceSn, "SWITCH", "SWITCH", "nxcloud_intersight_config", "nexus_cloud_internal"))
            return respObj

        OVERWRITE_GLOBAL_NXC = fabricSettings.get("OVERWRITE_GLOBAL_NXC", "false")
        if OVERWRITE_GLOBAL_NXC == "true":
            NXC_DEST_VRF      = fabricSettings.get("NXC_DEST_VRF", "")
            NXC_SRC_INTF      = fabricSettings.get("NXC_SRC_INTF", "")
            NXC_PROXY_SERVER  = fabricSettings.get("NXC_PROXY_SERVER", "")
            NXC_PROXY_PORT    = fabricSettings.get("NXC_PROXY_PORT", "")
        else:
            nxcGlobalSettings = Util.exe(FabricWrapper.getNXCGlobalSettings())
            Wrapper.print("%s: nxcGlobalSettings %s" % (funcName, nxcGlobalSettings))
            NXC_DEST_VRF      = nxcGlobalSettings.get("sourceVrf", "")
            NXC_SRC_INTF      = nxcGlobalSettings.get("sourceIntf", "")
            NXC_PROXY_SERVER  = nxcGlobalSettings.get("proxyIp", "")
            NXC_PROXY_PORT    = nxcGlobalSettings.get("proxyPort", "")
        Wrapper.print("%s: NXC_SRC_INTF %s NXC_DEST_VRF %s NXC_PROXY_SERVER %s NXC_PROXY_PORT %s" %
                      (funcName, NXC_SRC_INTF, NXC_DEST_VRF, NXC_PROXY_SERVER, NXC_PROXY_PORT))
        
        nxcDestVrf = "default" if NXC_DEST_VRF.strip().lower() == "default" else NXC_DEST_VRF.strip()
        if nxcDestVrf.lower() == "management":
            nxcDestVrf = "management"
            NXC_SRC_INTF = ""   # Do not configure source-interface if destination VRF is management

        nxcSrcIntf = ""
        if NXC_SRC_INTF != "":
            nxcSrcIntf = Util.getIntfFullName(NXC_SRC_INTF)
            intfType = Util.getIntfFullType(NXC_SRC_INTF)
            if intfType == "Loopback" or intfType == "Port-Channel":
                nxcSrcIntf = nxcSrcIntf.lower()

        l3IntfTemplates = ["int_loopback", "int_l3_port_channel", "int_vlan", "int_freeform"]

        nonCloudDevices = []
        for deviceSn in devices:
            if not Util.isCloudScaleDevice(FABRIC_NAME, deviceSn, topologyDataObj):
                hostName = topologyDataObj.get(TopologyInfoType.HOSTNAME, deviceSn)
                nonCloudDevices.append(("%s(%s)" %(hostName,deviceSn)))
                continue

            if nxcSrcIntf != "":
                ptiList = Util.exe(PTIWrapper.getPTIs(deviceSn, "INTERFACE", nxcSrcIntf, "PYTHON"))
                if len(ptiList) == 0:
                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                                           "Intersight Source Interface [%s] for communication to Nexus Cloud does not exist "
                                           "or is not attached to any interface policy, "
                                           "please create the interface and perform Recalculate Config again"
                                           % nxcSrcIntf, deviceSn)
                    respObj.setFailureRetCode()
                    continue

                if ptiList[0].getTemplateName() not in l3IntfTemplates:
                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                                           "Intersight Source Interface [%s] for communication to Nexus Cloud must be a Layer-3 interface, "
                                           "please edit the interface and make it L3 with proper config"
                                           % nxcSrcIntf, deviceSn)
                    respObj.setFailureRetCode()
                    continue

                intfIpFound = False
                if ptiList[0].getTemplateName() != "int_freeform":
                    INTF_VRF = ptiList[0].nvPairs.get("INTF_VRF", "")
                    intfVrf = "default" if INTF_VRF == "" or INTF_VRF.strip().lower() == "default" else INTF_VRF.strip()
                    ip = ptiList[0].nvPairs.get("IP", "")
                    v6Ip = ptiList[0].nvPairs.get("V6IP", "")      # int_loopback
                    if ip != "" or v6Ip != "":
                        intfIpFound = True
                    else:
                        CONF = ptiList[0].nvPairs.get("CONF", "")
                        cmds = CONF.splitlines()
                        for cmd in cmds:
                            cmd = re.sub(" +", " ", cmd.strip())
                            if cmd.strip().startswith("ip address") or cmd.strip().startswith("ipv6 address"):
                                intfIpFound = True
                                break
                else:
                    intfVrf = "default"
                    CONF = ptiList[0].nvPairs.get("CONF", "")
                    cmds = CONF.splitlines()
                    for cmd in cmds:
                        cmd = re.sub(" +", " ", cmd.strip())
                        if cmd.strip().startswith("vrf member"):
                            ignore, intfVrf = cmd.split("vrf member ")
                        elif cmd.strip().startswith("ip address") or cmd.strip().startswith("ipv6 address"):
                            intfIpFound = True
    
                srcIntfError = False
                if not intfIpFound:
                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                                           "Intersight Source Interface [%s] for communication to Nexus Cloud must have an IP address, "
                                           "please configure an IP address with proper config to the interface"
                                           % nxcSrcIntf, deviceSn)
                    respObj.setFailureRetCode()
                    srcIntfError = True

                if intfVrf != nxcDestVrf:
                    respObj.addErrorReport(getFabErrEntity(funcName, deviceSn),
                                           "Intersight Source Interface [%s] for communication to Nexus Cloud must be in the same VRF as "
                                           "Intersight Destination VRF [%s], interface is in VRF [%s]"
                                           % (nxcSrcIntf, nxcDestVrf, intfVrf), deviceSn)
                    respObj.setFailureRetCode()
                    srcIntfError = True

                if srcIntfError:
                    continue

            Util.exe(PTIWrapper.createOrUpdate(deviceSn, "SWITCH", "SWITCH", "nxcloud_intersight_config", ConfigPriority.CONFIG_PRIO_UNDERLAY_MIDDLE,
                                               "nexus_cloud_internal",
                                               {"NXC_SRC_INTF": nxcSrcIntf,
                                                "NXC_DEST_VRF": nxcDestVrf,
                                                "NXC_PROXY_SERVER": NXC_PROXY_SERVER.strip() if NXC_PROXY_SERVER != "" else "",
                                                "NXC_PROXY_PORT": NXC_PROXY_PORT}))
            
            showRunVrfMgmt = "false"
            ptiList = Util.exe(PTIWrapper.get(deviceSn, "SWITCH", "SWITCH", "UNDERLAY", "nexus_cloud"))
            for pti in ptiList:
                ptiNvPairs = pti.getNvPairs()
                ptiDestVrf = ptiNvPairs["NXC_DEST_VRF"]
                if ptiDestVrf != "" and ptiDestVrf.strip().lower() == "management" and nxcDestVrf == "management":
                    showRunVrfMgmt = ptiNvPairs["SHOW_RUN_VRF_MGMT"]

            Util.exe(PTIWrapper.createOrUpdate(deviceSn, "SWITCH", "SWITCH", "UNDERLAY",
                                               ConfigPriority.CONFIG_PRIO_UNDERLAY_MIDDLE,
                                               "nexus_cloud",
                                               {"NXC_SRC_INTF": nxcSrcIntf,
                                                "NXC_DEST_VRF": nxcDestVrf if NXC_DEST_VRF != "" else "",
                                                "NXC_PROXY_SERVER": NXC_PROXY_SERVER.strip() if NXC_PROXY_SERVER != "" else "",
                                                "NXC_PROXY_PORT": NXC_PROXY_PORT,
                                                "SHOW_RUN_VRF_MGMT": showRunVrfMgmt}))

        if len(nonCloudDevices) > 0:
            respObj.addWarnReport(getFabErrEntity(funcName, FABRIC_NAME+":# Non-Cloud Devices="+str(len(nonCloudDevices))),
                                  "Nexus Cloud is only supported on N9K-C9332C, N9K-C9364C, "
                                  "Nexus 9300-EX/FX/FXP/FX2/FX3/GX/GX2, 9500 and 9800 modular platforms. "
                                  "Following devices do not support the Nexus Cloud feature: %s" %
                                  (",".join(nonCloudDevices)))
            respObj.setWarningRetCode()

        return respObj
    except respObjError as e:
        return e.value

# handle track, untrack and change the tracking fabric (btw MSD and child fabric)
def siteIdTracking(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()
        FABRIC_NAME             = dictObj["FABRIC_NAME"]
        parentFabricName        = dictObj.get("MSD_FABRIC_NAME", "")
        fabricSettings          = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        ENABLE_TRM              = fabricSettings.get("ENABLE_TRM", "false")
        ENABLE_TRMv6            = fabricSettings.get("ENABLE_TRMv6", "false")
        ALLOW_L3VNI_NO_VLAN     = fabricSettings.get("ALLOW_L3VNI_NO_VLAN", "false")
        SITE_ID                 = fabricSettings.get("SITE_ID", "")
        SITE_ID_POLICY_ID       = fabricSettings.get("SITE_ID_POLICY_ID", "")
        UNDERLAY_IS_V6_TMPLT_VAR = fabricSettings.get("UNDERLAY_IS_V6", "false")
        UNDERLAY_IS_V6 = UNDERLAY_IS_V6_TMPLT_VAR == "true"

        Wrapper.print("%s [%s]: SITE_ID %s SITE_ID_POLICY_ID %s" %(funcName, FABRIC_NAME, SITE_ID, SITE_ID_POLICY_ID))

        if (ENABLE_TRM == "true" or ENABLE_TRMv6 == "true") and (UNDERLAY_IS_V6 or ALLOW_L3VNI_NO_VLAN == "true"):
            allocateMvpnVriId = True
        else:
            allocateMvpnVriId = False

        if allocateMvpnVriId and SITE_ID and int(SITE_ID) < 65536:
            if parentFabricName == "":
                try:
                    getRespObj = FabricWrapper.getParentFabricName(FABRIC_NAME)
                    if getRespObj.isRetCodeSuccess():
                        parentFabricName = getRespObj.getValue()
                except:
                    pass

            trackFabricName = FABRIC_NAME
            if parentFabricName:
                msdFabricSettings = Util.exe(FabricWrapper.get(parentFabricName)).getNvPairs()
                if msdFabricSettings.get("ENABLE_TRM_TRMv6", "false") == "true":
                    trackFabricName = parentFabricName

            Wrapper.print("%s: tracking fabric %s" %(funcName, trackFabricName))

            # always do RM.set as we do not know whether SITE_ID is changed and which fabric tracked it
            try:
                ignore, rmId = Util.exeRM(RM.set(trackFabricName, "MVPN_VRI_ID", FABRIC_NAME, SITE_ID))
            except:
                Wrapper.print("%s exception on set site id %s in fabric %s"% (funcName, SITE_ID, trackFabricName))
                errorMsg = "Site id [%s] is already used in fabric %s for either another site id or MVPN VRI ID. Please use a unique site id"% (SITE_ID, trackFabricName)
                respObj.addErrorReport(funcName, errorMsg)
                respObj.setFailureRetCode()
                return respObj

            if SITE_ID_POLICY_ID:
                policyIdNum, oldRmId = SITE_ID_POLICY_ID.split(".")
            else:
                policyIdNum = oldRmId = ""

            if oldRmId:
                if int(oldRmId) != rmId:
                    PTIWrapper.deletePtiVsRMForPolicyId(int(policyIdNum))
                    Util.exeRM(RM.deleteResource(int(oldRmId)))
                    Wrapper.print("%s released old RM id %s for fabric %s, policy %s"% (funcName, oldRmId, FABRIC_NAME, policyIdNum))

                    RM.linkResource(int(policyIdNum), rmId)
                    Wrapper.print("%s site id %s tracked in policyId %s, rmId %s, fabric %s" %(funcName, SITE_ID, policyIdNum, rmId, trackFabricName))
                else:
                    Wrapper.print("%s no change in RM id %s for fabric %s, policy %s"% (funcName, rmId, FABRIC_NAME, policyIdNum))
            else:
                if policyIdNum == "":
                    policyIdNum = Util.exe(PTIWrapper.getPolicyID())
                RM.linkResource(int(policyIdNum), rmId)

            newPolicyStr = str(policyIdNum) + "." + str(rmId)
            if newPolicyStr != SITE_ID_POLICY_ID:
                Util.exe(FabricWrapper.update(FABRIC_NAME, "SITE_ID_POLICY_ID", newPolicyStr))
        else:
            Wrapper.print("%s site id %s, no tracking "% (funcName, SITE_ID))
            if SITE_ID_POLICY_ID != "":
                Wrapper.print("%s release RM tracking policy %s for site id %s"% (funcName, SITE_ID_POLICY_ID, SITE_ID))
                policyIdNum, oldRmId = SITE_ID_POLICY_ID.split(".")
                if oldRmId:
                    PTIWrapper.deletePtiVsRMForPolicyId(int(policyIdNum))
                    Util.exeRM(RM.deleteResource(int(oldRmId)))
                    newPolicyStr = str(policyIdNum) + "."
                    Util.exe(FabricWrapper.update(FABRIC_NAME, "SITE_ID_POLICY_ID", newPolicyStr))

        return respObj
    except respObjError as e:
        Wrapper.print("%s [%s] site id %s, exception "% (funcName, FABRIC_NAME, SITE_ID))
        return e.value

# check whether ALLOW_L3VNI_NO_VLAN can be changed
# do not allow changing it to false if any Mando VTEP present or any vrf has L3VNI_NO_VLAN
def checkL3VniNoVlanSettings(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        Wrapper.print("======== %s ==========" % funcName)
        FABRIC_NAME           = dictObj["FABRIC_NAME"]
        fabricSettings        = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        ALLOW_L3VNI_NO_VLAN   = fabricSettings.get("ALLOW_L3VNI_NO_VLAN", "true")
        ALLOW_L3VNI_NO_VLAN_PREV   = fabricSettings.get("ALLOW_L3VNI_NO_VLAN_PREV", "true")
        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()

        if ALLOW_L3VNI_NO_VLAN == "true" or ALLOW_L3VNI_NO_VLAN == ALLOW_L3VNI_NO_VLAN_PREV:
            return respObj

        # check whether there is any vrf with L3VNI_NO_VLAN mode
        mfdWrapper = MfdWrapper.getMfdWrapper()
        mfdObj = mfdWrapper.getVrfList(FABRIC_NAME)
        if mfdObj.isRetCodeSuccess():
            fabricVrfList = mfdObj.getRespList()
            for vrf in fabricVrfList:
                vrfParams = vrf.get("vrfTemplateParams", None)
                if vrfParams != None:
                    enableL3VniNoVlan = vrfParams.get("enableL3VniNoVlan", "false")
                    if enableL3VniNoVlan == "true":
                        respObj.addErrorReport(funcName,
                                           "'Allow L3VNI w/o VLAN' cannot be turned off when any vrf has 'Enable L3VNI w/o VLAN' turned on. 'Enable L3VNI w/o VLAN' is turned on for vrf %s. "% vrf.get("vrfName", ""))
                        respObj.setFailureRetCode()
                        return respObj

        topologyDataObj = TopologyData(Util.exe(TopologyWrapper.get(FABRIC_NAME)))
        devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
        devices = filter(None, devices)
        for deviceSn in devices:
            switchRole = topologyDataObj.getSwitchRole(deviceSn)
            if switchRole == "spine" or switchRole == "super spine" or switchRole == "tor":
                continue

            devModel = topologyDataObj.getSwitchModel(deviceSn)
            if devModel.startswith("N9K-C98"):
                respObj.addErrorReport(funcName,
                                       "'Allow L3VNI w/o VLAN' cannot be turned off when N9K-C9800 is present in the fabric as VTEP", deviceSn)
                respObj.setFailureRetCode()
                return respObj

        return respObj
    except respObjError as e:
        return e.value

def processMvpnVriRealloc(dictObj):
    try:
        funcName = sys._getframe(0).f_code.co_name
        Wrapper.print("======== %s ==========" % funcName)
        FABRIC_NAME           = dictObj["FABRIC_NAME"]
        topologyDataObj       = dictObj["topologyDataObj"]
        fabricSettings        = Util.exe(FabricWrapper.get(FABRIC_NAME)).getNvPairs()
        ENABLE_TRM            = fabricSettings.get("ENABLE_TRM", "false")
        ENABLE_TRMv6          = fabricSettings.get("ENABLE_TRMv6", "false")
        ALLOW_L3VNI_NO_VLAN   = fabricSettings.get("ALLOW_L3VNI_NO_VLAN", "false")
        MVPN_VRI_ID_RANGE     = fabricSettings.get("MVPN_VRI_ID_RANGE", "")

        UNDERLAY_IS_V6_TMPLT_VAR = fabricSettings.get("UNDERLAY_IS_V6", "false")
        UNDERLAY_IS_V6 = UNDERLAY_IS_V6_TMPLT_VAR == "true"

        respObj = WrappersResp.getRespObj()
        respObj.setSuccessRetCode()
        
        if (ENABLE_TRM == "true" or ENABLE_TRMv6 == "true") and (UNDERLAY_IS_V6 or ALLOW_L3VNI_NO_VLAN == "true"):
            allocateMvpnVriId = True
        else:
            allocateMvpnVriId = False

        if not allocateMvpnVriId:
            return respObj

        if MVPN_VRI_ID_RANGE == "":
            Wrapper.print("%s [%s], empty MVPN_VRI_ID_RANGE"% (funcName, FABRIC_NAME))
            respObj.addErrorReport(funcName, "Cannot re-allocate MVNP VRI ID for fabric %s with empty 'MVPN VRI ID Range'"%FABRIC_NAME)
            respObj.setFailureRetCode()
            return respObj

        minVriId, maxVriId = MVPN_VRI_ID_RANGE.split("-")
        devices = topologyDataObj.get(TopologyInfoType.SWITCHES)
        devices = filter(None, devices)

        srchOpt = CtrlPolicySearch()
        srchOpt.setTemplateName("mvpn_vri_id_jython")
        srchOpt2 = CtrlPolicySearch()
        srchOpt2.setTemplateName("mvpn_vri_id")
        for deviceSn in devices:
            isSwitchVPC = Util.exe(VpcWrapper.isVpc(FABRIC_NAME, deviceSn))
            if not isSwitchVPC:
                continue

            srchOpt.setSerialNumber(deviceSn)
            ptiList = Util.exe(PTIWrapper.getPTIs(srchOpt))

            for pti in ptiList:
                vriId = pti.getNvPairs()["VRI_ID"]
                if vriId >= minVriId and vriId <= maxVriId:
                    continue
                nvPairs = copy.deepcopy(pti.getNvPairs())
                vpcPeerSn = nvPairs["VPC_PEER_SN"]
                vpcPairSerialKey = Util.exe(Helper.getKey("DevicePair", deviceSn, vpcPeerSn))

                ignore, rmId = Util.exeRM(RM.getSwitchMvpnVriId(FABRIC_NAME, "MVPN_VRI_ID", FABRIC_NAME, vpcPairSerialKey))
                srchOpt2.setSerialNumber(deviceSn)
                cliPtiList = Util.exe(PTIWrapper.getPTIs(srchOpt2))
                srchOpt2.setSerialNumber(vpcPeerSn)
                cliPtiList += Util.exe(PTIWrapper.getPTIs(srchOpt2))
                for cliPti in cliPtiList:
                    Wrapper.print("%s [%s]: delete mvpn_vri_id %s CLI policy %s"%(funcName, cliPti.getSerialNumber(), vriId, cliPti.getPolicyId()))
                    Util.exe(PTIWrapper.deleteInstance(cliPti.getPolicyId()))

                Wrapper.print("%s: delete resource %s for VRI id %s"%(funcName, rmId, vriId))
                Util.exeRM(RM.deleteResource(rmId))

                mvpnVriId, newRmId = Util.exeRM(RM.getSwitchMvpnVriId(FABRIC_NAME, "MVPN_VRI_ID", FABRIC_NAME, vpcPairSerialKey))
                Wrapper.print("%s [%s]: new VRI id %s, rmId %s"%(funcName, vpcPairSerialKey, mvpnVriId, newRmId))
                nvPairs["VRI_ID"] = mvpnVriId
                Util.exe(PTIWrapper.updateInstance(pti.getPolicyId(), nvPairs))

                # update its VPC peer
                srchOpt.setSerialNumber(vpcPeerSn)
                peerPtiList = Util.exe(PTIWrapper.getPTIs(srchOpt))
                for peerPti in peerPtiList:
                    peerNvPairs = copy.deepcopy(peerPti.getNvPairs())
                    peerNvPairs["VRI_ID"] = mvpnVriId
                    Util.exe(PTIWrapper.updateInstance(peerPti.getPolicyId(), peerNvPairs))

    except Exception as e:
        respObj.addErrorReport(funcName,"Exception in " + funcName + " " + repr(e))
        respObj.setFailureRetCode()
        Wrapper.print("Exception in %s" % (funcName))
    finally:
        return respObj

